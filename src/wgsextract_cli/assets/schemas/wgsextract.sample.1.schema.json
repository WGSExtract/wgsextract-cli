{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wgsextract:schema:sample:1",
  "title": "wgsextract.sample/1",
  "description": "A sample workspace: wgsextract.sample.toml in a genome folder, as parsed from TOML. Records the facts commands detected from each of the sample's files, the user's overrides and the result manifests written there. Unknown top-level keys are kept. See docs/sample-workspace.md.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "wgsextract.sample/1"
    },
    "override": {
      "$ref": "#/$defs/override",
      "description": "Facts the user set; commands use them instead of what they detect, and warn when the reads disagree. A value here is folder-wide, honoured for sex in a genome folder only; a table holds one file's overrides (path relative to the workspace, or absolute), honoured while its fingerprint matches."
    },
    "detected": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/file"
      },
      "description": "Per file (path relative to the workspace, or absolute), the facts detected from it. They hold only while the file's fingerprint matches."
    },
    "outputs": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/output"
      },
      "description": "Result manifests (<output>.manifest.json) written in the workspace by --genome runs."
    }
  },
  "required": [
    "schema"
  ],
  "$defs": {
    "override": {
      "type": "object",
      "properties": {
        "sex": {
          "$ref": "#/$defs/sex"
        },
        "platform": {
          "$ref": "#/$defs/platform"
        }
      },
      "additionalProperties": {
        "$ref": "#/$defs/file_override"
      }
    },
    "sex": {
      "enum": [
        "Male",
        "Female"
      ]
    },
    "platform": {
      "enum": [
        "illumina",
        "ont",
        "pacbio",
        "ultima",
        "dnbseq"
      ]
    },
    "file_override": {
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string"
        },
        "sex": {
          "$ref": "#/$defs/sex"
        },
        "platform": {
          "$ref": "#/$defs/platform"
        }
      },
      "required": [
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "fingerprint": {
          "type": "string",
          "description": "The file's wgse-fp1 content fingerprint when the facts were detected (see the result manifest).",
          "pattern": "^wgse-fp1:[0-9a-f]{64}$"
        },
        "sex": {
          "$ref": "#/$defs/observed_sex_fact"
        },
        "platform": {
          "$ref": "#/$defs/platform_fact"
        },
        "build": {
          "$ref": "#/$defs/build_fact"
        },
        "somalier_sex": {
          "$ref": "#/$defs/sex_fact"
        },
        "superpopulation": {
          "$ref": "#/$defs/superpopulation_fact"
        },
        "read_length": {
          "$ref": "#/$defs/nonnegative_fact"
        },
        "mean_coverage": {
          "$ref": "#/$defs/nonnegative_fact"
        },
        "contamination": {
          "$ref": "#/$defs/fraction_fact"
        },
        "ancestry": {
          "$ref": "#/$defs/ancestry_fact"
        },
        "target_depths": {
          "$ref": "#/$defs/depths_fact"
        }
      },
      "required": [
        "fingerprint"
      ],
      "additionalProperties": {
        "$ref": "#/$defs/fact"
      }
    },
    "observed_sex_fact": {
      "type": "object",
      "properties": {
        "statistics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "method": {
          "type": "string",
          "description": "How it was detected."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "version": {
          "type": "integer",
          "description": "Detector version; a fact from another version is detected again.",
          "minimum": 1
        },
        "by": {
          "type": "string",
          "description": "\"wgsextract <version> <command>\"."
        },
        "at": {
          "type": "string",
          "description": "UTC time it was detected.",
          "format": "date-time"
        },
        "value": {
          "enum": [
            "Male",
            "Female",
            "Unknown"
          ]
        }
      },
      "required": [
        "method",
        "confidence",
        "version",
        "by",
        "at",
        "value"
      ]
    },
    "platform_fact": {
      "type": "object",
      "properties": {
        "statistics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "method": {
          "type": "string",
          "description": "How it was detected."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "version": {
          "type": "integer",
          "description": "Detector version; a fact from another version is detected again.",
          "minimum": 1
        },
        "by": {
          "type": "string",
          "description": "\"wgsextract <version> <command>\"."
        },
        "at": {
          "type": "string",
          "description": "UTC time it was detected.",
          "format": "date-time"
        },
        "value": {
          "enum": [
            "illumina",
            "ont",
            "pacbio",
            "ultima",
            "dnbseq",
            "Unknown"
          ]
        }
      },
      "required": [
        "method",
        "confidence",
        "version",
        "by",
        "at",
        "value"
      ]
    },
    "build_fact": {
      "type": "object",
      "properties": {
        "statistics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "method": {
          "type": "string",
          "description": "How it was detected."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "version": {
          "type": "integer",
          "description": "Detector version; a fact from another version is detected again.",
          "minimum": 1
        },
        "by": {
          "type": "string",
          "description": "\"wgsextract <version> <command>\"."
        },
        "at": {
          "type": "string",
          "description": "UTC time it was detected.",
          "format": "date-time"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "method",
        "confidence",
        "version",
        "by",
        "at",
        "value"
      ]
    },
    "sex_fact": {
      "type": "object",
      "properties": {
        "statistics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "method": {
          "type": "string",
          "description": "How it was detected."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "version": {
          "type": "integer",
          "description": "Detector version; a fact from another version is detected again.",
          "minimum": 1
        },
        "by": {
          "type": "string",
          "description": "\"wgsextract <version> <command>\"."
        },
        "at": {
          "type": "string",
          "description": "UTC time it was detected.",
          "format": "date-time"
        },
        "value": {
          "$ref": "#/$defs/sex"
        }
      },
      "required": [
        "method",
        "confidence",
        "version",
        "by",
        "at",
        "value"
      ]
    },
    "superpopulation_fact": {
      "type": "object",
      "properties": {
        "statistics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "method": {
          "type": "string",
          "description": "How it was detected."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "version": {
          "type": "integer",
          "description": "Detector version; a fact from another version is detected again.",
          "minimum": 1
        },
        "by": {
          "type": "string",
          "description": "\"wgsextract <version> <command>\"."
        },
        "at": {
          "type": "string",
          "description": "UTC time it was detected.",
          "format": "date-time"
        },
        "value": {
          "enum": [
            "AFR",
            "AMR",
            "EAS",
            "EUR",
            "SAS"
          ]
        }
      },
      "required": [
        "method",
        "confidence",
        "version",
        "by",
        "at",
        "value"
      ]
    },
    "nonnegative_fact": {
      "type": "object",
      "properties": {
        "statistics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "method": {
          "type": "string",
          "description": "How it was detected."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "version": {
          "type": "integer",
          "description": "Detector version; a fact from another version is detected again.",
          "minimum": 1
        },
        "by": {
          "type": "string",
          "description": "\"wgsextract <version> <command>\"."
        },
        "at": {
          "type": "string",
          "description": "UTC time it was detected.",
          "format": "date-time"
        },
        "value": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "method",
        "confidence",
        "version",
        "by",
        "at",
        "value"
      ]
    },
    "fraction_fact": {
      "type": "object",
      "properties": {
        "statistics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "method": {
          "type": "string",
          "description": "How it was detected."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "version": {
          "type": "integer",
          "description": "Detector version; a fact from another version is detected again.",
          "minimum": 1
        },
        "by": {
          "type": "string",
          "description": "\"wgsextract <version> <command>\"."
        },
        "at": {
          "type": "string",
          "description": "UTC time it was detected.",
          "format": "date-time"
        },
        "value": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "method",
        "confidence",
        "version",
        "by",
        "at",
        "value"
      ]
    },
    "ancestry_fact": {
      "type": "object",
      "properties": {
        "statistics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "method": {
          "type": "string",
          "description": "How it was detected."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "version": {
          "type": "integer",
          "description": "Detector version; a fact from another version is detected again.",
          "minimum": 1
        },
        "by": {
          "type": "string",
          "description": "\"wgsextract <version> <command>\"."
        },
        "at": {
          "type": "string",
          "description": "UTC time it was detected.",
          "format": "date-time"
        },
        "value": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      },
      "required": [
        "method",
        "confidence",
        "version",
        "by",
        "at",
        "value"
      ]
    },
    "depths_fact": {
      "type": "object",
      "properties": {
        "statistics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "method": {
          "type": "string",
          "description": "How it was detected."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "version": {
          "type": "integer",
          "description": "Detector version; a fact from another version is detected again.",
          "minimum": 1
        },
        "by": {
          "type": "string",
          "description": "\"wgsextract <version> <command>\"."
        },
        "at": {
          "type": "string",
          "description": "UTC time it was detected.",
          "format": "date-time"
        },
        "value": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      },
      "required": [
        "method",
        "confidence",
        "version",
        "by",
        "at",
        "value"
      ]
    },
    "fact": {
      "type": "object",
      "properties": {
        "statistics": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "method": {
          "type": "string",
          "description": "How it was detected."
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "version": {
          "type": "integer",
          "description": "Detector version; a fact from another version is detected again.",
          "minimum": 1
        },
        "by": {
          "type": "string",
          "description": "\"wgsextract <version> <command>\"."
        },
        "at": {
          "type": "string",
          "description": "UTC time it was detected.",
          "format": "date-time"
        },
        "value": {}
      },
      "required": [
        "method",
        "confidence",
        "version",
        "by",
        "at",
        "value"
      ]
    },
    "output": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "cancelled"
          ]
        },
        "at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "command",
        "status",
        "at"
      ]
    }
  }
}
