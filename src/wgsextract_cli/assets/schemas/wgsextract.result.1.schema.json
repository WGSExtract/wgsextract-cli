{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wgsextract:schema:result:1",
  "title": "wgsextract.result/1",
  "description": "What one wgsextract command read, wrote and found. Written as <output>.manifest.json next to a command's outputs and printed to stdout by --json. See docs/result-manifest.md.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "wgsextract.result/1"
    },
    "command": {
      "type": "string",
      "description": "The subcommand path, e.g. \"vcf snp\".",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ok",
        "failed",
        "cancelled"
      ]
    },
    "exit_code": {
      "type": "integer",
      "description": "0 ok, 1 failure, 2 usage error, 3 missing dependency; 128+N after signal N.",
      "minimum": 0,
      "maximum": 255
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "metrics": {
      "$ref": "#/$defs/scalars"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "resources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/resource"
      }
    },
    "details": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ],
      "description": "Command-specific structured result, or null."
    },
    "manifest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Absolute path of the manifest file written for this run, or null when none was written."
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "run": {
      "$ref": "#/$defs/run",
      "description": "This run's identity in its workflow."
    }
  },
  "required": [
    "schema",
    "command",
    "status",
    "exit_code",
    "error",
    "inputs",
    "outputs",
    "metrics",
    "warnings",
    "resources",
    "details",
    "manifest",
    "provenance",
    "run"
  ],
  "additionalProperties": false,
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "failure",
            "usage",
            "missing_dependency",
            "cancelled"
          ]
        },
        "message": {
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "message"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Absolute path."
        },
        "kind": {
          "type": "string",
          "description": "File type from the name: bam, cram, vcf, fasta, fastq, bed, tsv, ..., directory or other."
        },
        "role": {
          "type": "string",
          "description": "What the file is to this command, e.g. input, snps, combined_kit."
        },
        "exists": {
          "type": "boolean"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "mtime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "format": "date-time"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "index": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absolute path of the file's index (.bai, .crai, .tbi, .csi, .fai), if any."
        },
        "metrics": {
          "$ref": "#/$defs/scalars"
        },
        "artifact": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact"
            },
            {
              "type": "null"
            }
          ],
          "description": "What a BAM, CRAM, VCF or BCF is and where it came from; absent for other files."
        }
      },
      "required": [
        "path",
        "kind",
        "role",
        "exists",
        "size_bytes",
        "mtime",
        "fingerprint",
        "index",
        "metrics"
      ],
      "additionalProperties": false
    },
    "fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^wgse-fp1:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "wgse-fp1:<sha256 of the size and the first, middle and last MiB>; see docs/result-manifest.md."
    },
    "scalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "scalars": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/scalar"
      }
    },
    "artifact": {
      "type": "object",
      "properties": {
        "origin": {
          "enum": [
            "this_run",
            "recorded",
            "external"
          ],
          "description": "this_run (written by this run or one of its steps), recorded (written by the earlier run named in producer) or external (nothing is known)."
        },
        "lifecycle": {
          "anyOf": [
            {
              "enum": [
                "final",
                "intermediate",
                "cache",
                "temp"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "final, intermediate, cache or temp; null if unknown."
        },
        "retained": {
          "type": "boolean",
          "description": "False when the run deleted it on purpose."
        },
        "digest_kind": {
          "anyOf": [
            {
              "enum": [
                "full",
                "sampled"
              ]
            },
            {
              "type": "null"
            }
          ],
          "description": "Whether the fingerprint read the whole file."
        },
        "assembly": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "hg19, hg38 or t2t from the header's chr1 length."
        },
        "reference": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Fingerprint of the FASTA it was made with."
        },
        "samples": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "index": {
          "anyOf": [
            {
              "$ref": "#/$defs/artifact_index"
            },
            {
              "type": "null"
            }
          ]
        },
        "producer": {
          "anyOf": [
            {
              "$ref": "#/$defs/producer"
            },
            {
              "type": "null"
            }
          ]
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source_edge"
          }
        }
      },
      "required": [
        "origin",
        "lifecycle",
        "retained",
        "digest_kind",
        "assembly",
        "reference",
        "samples",
        "index",
        "producer",
        "sources"
      ],
      "additionalProperties": false
    },
    "artifact_index": {
      "type": "object",
      "properties": {
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "enum": [
            "ready",
            "missing",
            "stale",
            "mismatched"
          ],
          "description": "ready; missing; stale (older than the file and pointing at blocks it no longer has); mismatched (another file's index)."
        }
      },
      "required": [
        "path",
        "state"
      ],
      "additionalProperties": false
    },
    "producer": {
      "type": "object",
      "properties": {
        "run": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "root": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "command": {
          "type": "string"
        },
        "step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "run",
        "root",
        "command",
        "step"
      ],
      "additionalProperties": false
    },
    "source_edge": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "role": {
          "type": "string"
        },
        "fingerprint": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "wgse-fp1 fingerprint, as a file record's."
        },
        "producer": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "The run that wrote the source, when recorded."
        },
        "lifecycle": {
          "anyOf": [
            {
              "enum": [
                "final",
                "intermediate",
                "cache",
                "temp"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "retained": {
          "type": "boolean"
        }
      },
      "required": [
        "path",
        "role",
        "fingerprint",
        "producer",
        "lifecycle",
        "retained"
      ],
      "additionalProperties": false
    },
    "warning": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/scalars"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": false
    },
    "resource": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable resource identifier, e.g. \"clinvar\" or \"gene-list\".",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "description": "What the run used it for, e.g. annotation."
        },
        "build": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "hg19 or hg38, when the resource says."
        },
        "release": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The exact release name the run used, or null when the resource doesn't record one (unknown, never guessed)."
        },
        "release_basis": {
          "enum": [
            "file_header",
            "pinned_sha256",
            "unrecorded"
          ],
          "description": "Where the release came from: the file's own header, a SHA-256-pinned catalog entry, or unrecorded."
        },
        "path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absolute path."
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "source_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "licence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The source's terms as audited; recording them grants no redistribution rights."
        },
        "licence_url": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "attribution": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "name",
        "role",
        "build",
        "release",
        "release_basis",
        "path",
        "fingerprint",
        "source_url",
        "licence",
        "licence_url",
        "attribution"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "description": "wgsextract-cli version."
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {},
          "description": "Effective option values after config defaults; secrets redacted."
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Version of each external tool the command ran."
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "started": {
          "type": "string",
          "format": "date-time"
        },
        "finished": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "version",
        "argv",
        "params",
        "tools",
        "reference",
        "platform",
        "python",
        "started",
        "finished",
        "elapsed_s"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "build": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      },
      "required": [
        "path",
        "build",
        "fingerprint"
      ],
      "additionalProperties": false
    },
    "run": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{32}$"
        },
        "root": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "The workflow's first run; this run's id at the top."
        },
        "parent": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "The run that started this one."
        },
        "step": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "This run's step in its parent."
        },
        "children": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/child_run"
          }
        }
      },
      "required": [
        "id",
        "root",
        "parent",
        "step",
        "children"
      ],
      "additionalProperties": false
    },
    "child_run": {
      "type": "object",
      "properties": {
        "step": {
          "type": "string"
        },
        "run": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            {
              "type": "null"
            }
          ],
          "description": "The step's command run; null when it left no result."
        },
        "command": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "status": {
          "enum": [
            "ok",
            "failed",
            "cancelled",
            "reused"
          ]
        },
        "reason": {
          "type": "string",
          "description": "Why the step ran or was reused."
        }
      },
      "required": [
        "step",
        "run",
        "command",
        "status",
        "reason"
      ],
      "additionalProperties": false
    }
  }
}
