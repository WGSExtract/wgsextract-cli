{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wgsextract:schema:result:1",
  "title": "wgsextract.result/1",
  "description": "What one wgsextract command read, wrote and found. Written as <output>.manifest.json next to a command's outputs and printed to stdout by --json. See docs/result-manifest.md.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "wgsextract.result/1"
    },
    "command": {
      "type": "string",
      "description": "The subcommand path, e.g. \"vcf snp\".",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ok",
        "failed",
        "cancelled"
      ]
    },
    "exit_code": {
      "type": "integer",
      "description": "0 ok, 1 failure, 2 usage error, 3 missing dependency; 128+N after signal N.",
      "minimum": 0,
      "maximum": 255
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/error"
        },
        {
          "type": "null"
        }
      ]
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "metrics": {
      "$ref": "#/$defs/scalars"
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "details": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": {}
        },
        {
          "type": "null"
        }
      ],
      "description": "Command-specific structured result, or null."
    },
    "manifest": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "description": "Absolute path of the manifest file written for this run, or null when none was written."
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    }
  },
  "required": [
    "schema",
    "command",
    "status",
    "exit_code",
    "error",
    "inputs",
    "outputs",
    "metrics",
    "warnings",
    "details",
    "manifest",
    "provenance"
  ],
  "additionalProperties": false,
  "$defs": {
    "error": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "failure",
            "usage",
            "missing_dependency",
            "cancelled"
          ]
        },
        "message": {
          "type": "string"
        },
        "code": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]*$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "message",
        "code"
      ],
      "additionalProperties": false
    },
    "file": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string",
          "description": "Absolute path."
        },
        "kind": {
          "type": "string",
          "description": "File type from the name: bam, cram, vcf, fasta, fastq, bed, tsv, ..., directory or other."
        },
        "role": {
          "type": "string",
          "description": "What the file is to this command, e.g. input, snps, combined_kit."
        },
        "exists": {
          "type": "boolean"
        },
        "size_bytes": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0
        },
        "mtime": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "format": "date-time"
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        },
        "index": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Absolute path of the file's index (.bai, .crai, .tbi, .csi, .fai), if any."
        },
        "metrics": {
          "$ref": "#/$defs/scalars"
        }
      },
      "required": [
        "path",
        "kind",
        "role",
        "exists",
        "size_bytes",
        "mtime",
        "fingerprint",
        "index",
        "metrics"
      ],
      "additionalProperties": false
    },
    "fingerprint": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^wgse-fp1:[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ],
      "description": "wgse-fp1:<sha256 of the size and the first, middle and last MiB>; see docs/result-manifest.md."
    },
    "scalar": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "integer"
        },
        {
          "type": "number"
        },
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ]
    },
    "scalars": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/scalar"
      }
    },
    "warning": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "message": {
          "type": "string"
        },
        "details": {
          "$ref": "#/$defs/scalars"
        }
      },
      "required": [
        "code",
        "message",
        "details"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "version": {
          "type": "string",
          "description": "wgsextract-cli version."
        },
        "argv": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "params": {
          "type": "object",
          "additionalProperties": {},
          "description": "Effective option values after config defaults; secrets redacted."
        },
        "tools": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Version of each external tool the command ran."
        },
        "reference": {
          "anyOf": [
            {
              "$ref": "#/$defs/reference"
            },
            {
              "type": "null"
            }
          ]
        },
        "platform": {
          "type": "string"
        },
        "python": {
          "type": "string"
        },
        "started": {
          "type": "string",
          "format": "date-time"
        },
        "finished": {
          "type": "string",
          "format": "date-time"
        },
        "elapsed_s": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "version",
        "argv",
        "params",
        "tools",
        "reference",
        "platform",
        "python",
        "started",
        "finished",
        "elapsed_s"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "build": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "fingerprint": {
          "$ref": "#/$defs/fingerprint"
        }
      },
      "required": [
        "path",
        "build",
        "fingerprint"
      ],
      "additionalProperties": false
    }
  }
}
