{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wgsextract:schema:report:1",
  "title": "wgsextract.report/1",
  "description": "A sample's personal report: what earlier wgsextract runs found, by section, each finding with a confidence label, its evidence and the 'technical result, not diagnosis' disclaimer. Written by `wgsextract report` as <sample>_personal_report.json. See docs/personal-report.md.",
  "type": "object",
  "required": [
    "schema",
    "generated",
    "wgsextract_version",
    "sample",
    "disclaimer",
    "guide",
    "confidence_reasons",
    "sections"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "wgsextract.report/1"
    },
    "generated": {
      "type": "string",
      "format": "date-time",
      "description": "When the report was built (UTC)."
    },
    "wgsextract_version": {
      "type": "string"
    },
    "sample": {
      "type": "object",
      "required": [
        "name",
        "folder",
        "alignment",
        "vcf",
        "workspace"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "description": "The sample's name: its alignment's (or VCF's) file name without extensions."
        },
        "folder": {
          "type": "string",
          "description": "The sample folder's name (not its full path). Every file path in the report is relative to this folder."
        },
        "alignment": {
          "type": [
            "string",
            "null"
          ],
          "description": "The BAM/CRAM the report describes, relative to the folder."
        },
        "vcf": {
          "type": [
            "string",
            "null"
          ],
          "description": "The sample's VCF used in hints, relative to the folder."
        },
        "workspace": {
          "type": [
            "string",
            "null"
          ],
          "description": "The sample workspace file, when there is one."
        }
      }
    },
    "disclaimer": {
      "type": "string"
    },
    "guide": {
      "type": "string"
    },
    "confidence_reasons": {
      "type": "object",
      "description": "Reason code -> plain-language explanation.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "sections": {
      "type": "object",
      "required": [
        "overview",
        "lineage",
        "pharmacogenomics",
        "clinvar",
        "structural_variants",
        "microarray"
      ],
      "additionalProperties": false,
      "properties": {
        "overview": {
          "allOf": [
            {
              "$ref": "#/$defs/section"
            }
          ],
          "required": [
            "facts",
            "qc"
          ],
          "properties": {
            "facts": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/fact"
              }
            },
            "qc": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/metric"
              }
            }
          }
        },
        "lineage": {
          "$ref": "#/$defs/section"
        },
        "ancestry": {
          "allOf": [
            {
              "$ref": "#/$defs/section"
            }
          ],
          "required": [
            "note",
            "components"
          ],
          "properties": {
            "note": {
              "type": "string"
            },
            "evidence": {
              "type": [
                "string",
                "null"
              ]
            },
            "metrics": {
              "type": "object"
            },
            "components": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "k",
                  "name",
                  "region",
                  "proportion",
                  "lower",
                  "upper",
                  "reference_populations"
                ],
                "properties": {
                  "k": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "name": {
                    "type": "string"
                  },
                  "region": {
                    "type": "string"
                  },
                  "proportion": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "lower": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "upper": {
                    "type": "number",
                    "minimum": 0,
                    "maximum": 1
                  },
                  "reference_populations": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "pharmacogenomics": {
          "$ref": "#/$defs/section"
        },
        "carrier_screening": {
          "$ref": "#/$defs/section"
        },
        "clinvar": {
          "allOf": [
            {
              "$ref": "#/$defs/section"
            }
          ],
          "required": [
            "gene_list"
          ],
          "properties": {
            "gene_list": {
              "$ref": "#/$defs/gene_list"
            },
            "build": {
              "enum": [
                "hg19",
                "hg38",
                null
              ]
            },
            "all_calls": {
              "type": [
                "string",
                "null"
              ],
              "description": "Every carried ClinVar P/LP call (confidence TSV), relative to the folder."
            },
            "all_conflicts": {
              "type": [
                "string",
                "null"
              ],
              "description": "Conflicting ClinVar assertions for review, not consensus P/LP, relative to the folder."
            },
            "counts": {
              "type": "object",
              "required": [
                "carried",
                "in_gene_list",
                "outside_gene_list",
                "high",
                "moderate",
                "low"
              ],
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            },
            "genes": {
              "type": "array",
              "description": "Each listed gene with P/LP calls, counted by zygosity.",
              "items": {
                "type": "object",
                "required": [
                  "gene",
                  "inheritance",
                  "heterozygous",
                  "homozygous",
                  "hemizygous",
                  "partial",
                  "phase",
                  "confidence",
                  "status",
                  "status_text"
                ],
                "additionalProperties": false,
                "properties": {
                  "gene": {
                    "type": "string"
                  },
                  "inheritance": {
                    "type": [
                      "string",
                      "null"
                    ],
                    "description": "The gene list's mode of inheritance (AD, AR, SD, XL); null when it gives none."
                  },
                  "heterozygous": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "homozygous": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "hemizygous": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Haploid calls (one allele in the genotype)."
                  },
                  "partial": {
                    "type": "integer",
                    "minimum": 0,
                    "description": "Calls whose other allele was not called (1/.)."
                  },
                  "phase": {
                    "enum": [
                      "trans",
                      "cis",
                      "unknown",
                      null
                    ],
                    "description": "The phase of two or more heterozygous calls: trans when two are on opposite copies (two ALTs of one call such as 1/2, or phased in one phase set), cis when all are phased on one copy in one phase set, else unknown (unphased, phased without a PS, or in different phase sets). Null for fewer than two, and when the calls are incomplete (calls_truncated) unless trans."
                  },
                  "confidence": {
                    "enum": [
                      "high",
                      "moderate",
                      "low",
                      "not_assessed"
                    ],
                    "description": "The weakest confidence label of the gene's calls."
                  },
                  "status": {
                    "enum": [
                      "biallelic",
                      "possible_biallelic",
                      "carrier",
                      null
                    ],
                    "description": "For a gene the list reports only when biallelic (AR): biallelic (a homozygous call, or two heterozygous calls in trans), possible_biallelic (two or more heterozygous calls not all phased together, or a hemizygous or partly called genotype) or carrier (one heterozygous call, or several in cis). Null for other genes, and when the calls are incomplete (calls_truncated) unless biallelic."
                  },
                  "status_text": {
                    "type": "string",
                    "description": "The status explained; empty when status is null."
                  }
                }
              }
            }
          }
        },
        "acmg_research": {
          "description": "fastVEP's automated ACMG/AMP classes (vcf acmg), research use only and not a diagnosis. Present only when vcf acmg ran.",
          "allOf": [
            {
              "$ref": "#/$defs/section"
            }
          ],
          "required": [
            "gene_list",
            "disclaimer"
          ],
          "properties": {
            "gene_list": {
              "$ref": "#/$defs/gene_list"
            },
            "disclaimer": {
              "type": "string",
              "description": "The research-only disclaimer, shown at the top of the section."
            },
            "tool": {
              "type": [
                "string",
                "null"
              ],
              "description": "The classifier and its version, e.g. 'fastVEP 0.5.0'."
            },
            "criteria_not_evaluated": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "ACMG/AMP criteria the classifier never evaluated."
            },
            "build": {
              "enum": [
                "hg19",
                "hg38",
                null
              ]
            },
            "all_calls": {
              "type": [
                "string",
                "null"
              ],
              "description": "The classified VCF (acmg_annotated.vcf.gz), relative to the folder."
            },
            "counts": {
              "type": "object",
              "description": "Carried alleles by automated class (p, lp, vus, lb, b), and the carried P/LP calls in_gene_list (the findings), outside_gene_list and unplaced.",
              "required": [
                "p",
                "lp",
                "vus",
                "lb",
                "b",
                "in_gene_list",
                "outside_gene_list",
                "unplaced"
              ],
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "structural_variants": {
          "allOf": [
            {
              "$ref": "#/$defs/section"
            }
          ],
          "properties": {
            "all_svs": {
              "type": [
                "string",
                "null"
              ],
              "description": "Every SV with its frequency class (sv_freq.tsv), relative to the folder."
            },
            "sources": {
              "type": "array"
            },
            "thresholds": {
              "type": "object",
              "properties": {
                "common_af": {
                  "type": "number"
                },
                "rare_af": {
                  "type": "number"
                }
              }
            },
            "counts": {
              "type": "object",
              "description": "Carried SVs by frequency class (common, low, rare, novel), and listed: the rare SVs shown as findings.",
              "additionalProperties": {
                "type": "integer",
                "minimum": 0
              }
            }
          }
        },
        "microarray": {
          "allOf": [
            {
              "$ref": "#/$defs/section"
            }
          ],
          "required": [
            "files"
          ],
          "properties": {
            "files": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "file",
                  "role",
                  "format",
                  "exists",
                  "sites",
                  "called",
                  "no_call_rate"
                ],
                "properties": {
                  "file": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "role": {
                    "type": "string"
                  },
                  "format": {
                    "type": [
                      "string",
                      "null"
                    ]
                  },
                  "exists": {
                    "type": "boolean"
                  },
                  "sites": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "called": {
                    "type": [
                      "integer",
                      "null"
                    ]
                  },
                  "no_call_rate": {
                    "type": [
                      "number",
                      "null"
                    ]
                  }
                }
              }
            },
            "metrics": {
              "type": "object"
            }
          }
        }
      }
    }
  },
  "$defs": {
    "gene_list": {
      "type": "object",
      "required": [
        "name",
        "version",
        "citation",
        "url",
        "genes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "A built-in list's id (acmg-sf-3.3), or the name of the user's TSV or BED file."
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "description": "Empty for a user's file."
        },
        "citation": {
          "type": "string",
          "description": "Empty for a user's file."
        },
        "url": {
          "type": "string",
          "description": "The published gene table a built-in list was checked against; empty for a user's file."
        },
        "genes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "section": {
      "type": "object",
      "required": [
        "title",
        "status",
        "summary",
        "findings",
        "missing",
        "warnings",
        "sources"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "status": {
          "enum": [
            "ok",
            "not_run",
            "failed"
          ],
          "description": "ok: at least one source run succeeded; not_run: no run found (see missing); failed: only failed runs found (see error)."
        },
        "summary": {
          "type": "string"
        },
        "error": {
          "type": "string"
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "missing": {
          "type": "array",
          "description": "Parts of the section not run yet, with the command that produces each (relative to the sample folder).",
          "items": {
            "$ref": "#/$defs/reportMissing"
          }
        },
        "warnings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reportWarning"
          }
        },
        "sources": {
          "type": "array",
          "description": "The result manifests the section was built from: the selected evidence's status and finish time, and the newest attempt when that is newer.",
          "items": {
            "$ref": "#/$defs/reportSource"
          }
        }
      }
    },
    "reportSource": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "finished": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "latest_attempt": {
          "anyOf": [
            {
              "$ref": "#/$defs/reportAttempt"
            },
            {
              "type": "null"
            }
          ],
          "description": "The sample's newest run of the same step when it is newer than this one, so it failed or was cancelled (the section also has a newer_attempt_failed warning); null (or absent, in reports written before it was added) when this run is the newest."
        }
      },
      "required": [
        "command",
        "status",
        "finished",
        "manifest"
      ],
      "additionalProperties": false
    },
    "reportAttempt": {
      "type": "object",
      "properties": {
        "command": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "finished": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "command",
        "status",
        "finished",
        "manifest"
      ],
      "additionalProperties": false
    },
    "reportWarning": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ]
    },
    "reportMissing": {
      "type": "object",
      "properties": {
        "what": {
          "type": "string"
        },
        "command": {
          "type": "string"
        }
      },
      "required": [
        "what",
        "command"
      ],
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "properties": {
        "section": {
          "enum": [
            "lineage",
            "pharmacogenomics",
            "carrier_screening",
            "clinvar",
            "acmg_research",
            "structural_variants"
          ]
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string"
        },
        "detail": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "gene": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "note": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "A caveat from the gene list, e.g. only biallelic calls are reportable."
        },
        "confidence": {
          "type": "string",
          "enum": [
            "high",
            "moderate",
            "low",
            "not_assessed"
          ]
        },
        "confidence_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "confidence_basis": {
          "type": "string",
          "description": "What the label was derived from."
        },
        "evidence": {
          "$ref": "#/$defs/reportEvidence"
        },
        "variant": {
          "anyOf": [
            {
              "$ref": "#/$defs/reportVariant"
            },
            {
              "type": "null"
            }
          ]
        },
        "links": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reportLink"
          }
        },
        "disclaimer": {
          "type": "string",
          "description": "Research use only for acmg_research findings.",
          "enum": [
            "Technical result, not diagnosis.",
            "Research use only; not a diagnosis."
          ]
        },
        "pgx": {
          "$ref": "#/$defs/reportPgx"
        }
      },
      "required": [
        "section",
        "label",
        "value",
        "detail",
        "gene",
        "note",
        "confidence",
        "confidence_reasons",
        "confidence_basis",
        "evidence",
        "variant",
        "links",
        "disclaimer"
      ],
      "additionalProperties": false
    },
    "reportEvidence": {
      "type": "object",
      "properties": {
        "file": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Evidence file, relative to the sample folder."
        },
        "region": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "chrom:pos, a chromosome or 'gene SYMBOL'."
        },
        "manifest": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "The run's result manifest, relative to the sample folder."
        }
      },
      "required": [
        "file",
        "region",
        "manifest"
      ],
      "additionalProperties": false
    },
    "reportVariant": {
      "type": "object",
      "properties": {
        "chrom": {
          "type": "string"
        },
        "pos": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "ref": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "alt": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "genotype": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "zygosity": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "depth": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "genotype_quality": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ]
        },
        "alt_fraction": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ]
        },
        "clinical_evidence": {
          "$ref": "#/$defs/reportClinicalEvidence"
        },
        "original_record": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "mnv_components": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "mnv_residual_copies": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 1,
          "maximum": 2
        },
        "phase_set": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "FORMAT/PS of a ClinVar call: calls phased (0|1) in one phase set are on known copies."
        }
      },
      "required": [
        "chrom",
        "pos",
        "ref",
        "alt",
        "genotype",
        "zygosity",
        "depth",
        "genotype_quality",
        "alt_fraction"
      ],
      "additionalProperties": false
    },
    "reportClinicalEvidence": {
      "type": "object",
      "properties": {
        "id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "review_status": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "stars": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "minimum": 0,
          "maximum": 4
        },
        "review_tier": {
          "type": "string"
        },
        "conflict": {
          "type": "boolean"
        },
        "conflict_evidence": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false
    },
    "reportLink": {
      "type": "object",
      "properties": {
        "label": {
          "type": "string"
        },
        "url": {
          "type": "string"
        }
      },
      "required": [
        "label",
        "url"
      ],
      "additionalProperties": false
    },
    "reportPgx": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "resolved",
            "ambiguous",
            "no_call"
          ]
        },
        "alternatives": {
