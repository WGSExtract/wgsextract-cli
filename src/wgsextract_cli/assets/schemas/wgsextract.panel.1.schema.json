{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wgsextract:schema:panel:1",
  "title": "wgsextract.panel/1",
  "description": "A declarative research panel (TOML or JSON). Research use only. See docs/panel.md.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "wgsextract.panel/1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "build": {
      "enum": [
        "GRCh38",
        "GRCh37",
        "CHM13v2.0"
      ]
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "defaults": {
      "$ref": "#/$defs/filters"
    },
    "groups": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/group"
      },
      "minItems": 1
    },
    "sites": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/site"
      },
      "minItems": 1
    },
    "haplotypes": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/haplotype"
      },
      "minItems": 1
    },
    "calibration": {
      "$ref": "#/$defs/calibration"
    }
  },
  "required": [
    "schema",
    "id",
    "name",
    "version"
  ],
  "additionalProperties": false,
  "$defs": {
    "source": {
      "type": "object",
      "properties": {
        "citation": {
          "type": "string"
        },
        "url": {
          "type": "string"
        },
        "license": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "description": "Free text, copied into outputs, never read.",
      "additionalProperties": false
    },
    "filters": {
      "type": "object",
      "properties": {
        "max_af": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_popmax_af": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "pass_only": {
          "type": "boolean"
        },
        "min_confidence": {
          "enum": [
            "high",
            "moderate",
            "low"
          ]
        },
        "missing_scores": {
          "enum": [
            "unscored",
            "drop"
          ]
        },
        "qualify": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/clause",
            "minProperties": 1
          },
          "minItems": 1
        }
      },
      "description": "Variant filters: the panel's defaults, or a group's overrides of them.",
      "additionalProperties": false
    },
    "clause": {
      "type": "object",
      "properties": {
        "impacts": {
          "type": "array",
          "items": {
            "enum": [
              "HIGH",
              "MODERATE",
              "LOW",
              "MODIFIER"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "consequences": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "A Sequence Ontology consequence term, e.g. missense_variant.",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "min_revel": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_cadd_phred": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "min_alphamissense": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "min_spliceai": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "description": "A variant passes a clause when it passes every key in it.",
      "additionalProperties": false
    },
    "group": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Letters, digits, '_', '.' or '-', starting with a letter or digit.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "genes": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "An HGNC symbol, a unique synonym, or an HGNC ID (HGNC:613).",
            "pattern": "^[^\\s,]+$"
          },
          "minItems": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "recessive": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "An HGNC symbol, a unique synonym, or an HGNC ID (HGNC:613).",
            "pattern": "^[^\\s,]+$"
          },
          "minItems": 1
        },
        "overrides": {
          "$ref": "#/$defs/filters"
        }
      },
      "required": [
        "id",
        "genes"
      ],
      "additionalProperties": false
    },
    "site": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Letters, digits, '_', '.' or '-', starting with a letter or digit.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "locus": {
          "type": "string",
          "description": "BUILD:CHROM:POS:REF>ALT, 1-based, e.g. GRCh38:chr1:11796321:G>A.",
          "pattern": "^(GRCh38|GRCh37|CHM13v2\\.0):(chr)?([1-9]|1[0-9]|2[0-2]|X|Y|M):([1-9][0-9]{0,9}):([ACGT]+)>([ACGT]+)$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rsid": {
          "type": "string",
          "pattern": "^rs[1-9][0-9]*$"
        }
      },
      "required": [
        "id",
        "locus"
      ],
      "additionalProperties": false
    },
    "haplotype": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Letters, digits, '_', '.' or '-', starting with a letter or digit.",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$"
        },
        "gene": {
          "type": "string",
          "description": "An HGNC symbol, a unique synonym, or an HGNC ID (HGNC:613).",
          "pattern": "^[^\\s,]+$"
        },
        "sites": {
          "type": "array",
          "items": {
            "type": "string",
            "description": "BUILD:CHROM:POS:REF, 1-based.",
            "pattern": "^(GRCh38|GRCh37|CHM13v2\\.0):(chr)?([1-9]|1[0-9]|2[0-2]|X|Y|M):([1-9][0-9]{0,9}):([ACGT]+)$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "alleles": {
          "type": "object",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[ACGT]+$"
            },
            "minItems": 1
          },
          "description": "Allele name -> its bases, one per site, in the sites' order.",
          "minProperties": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "gene",
        "sites",
        "alleles"
      ],
      "additionalProperties": false
    },
    "calibration": {
      "type": "object",
      "properties": {
        "null_sets": {
          "type": "integer",
          "minimum": 100,
          "maximum": 100000
        },
        "match_on": {
          "type": "array",
          "items": {
            "enum": [
              "callable_cds_bp",
              "gnomad_expected_syn"
            ]
          },
          "contains": {
            "const": "callable_cds_bp"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "bins": {
          "type": "integer",
          "minimum": 2,
          "maximum": 100
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740992
        }
      },
      "additionalProperties": false
    }
  }
}
