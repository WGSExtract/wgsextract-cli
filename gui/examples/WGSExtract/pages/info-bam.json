            {
              "id": "",
              "title": "options.cli.default.title"
            },
            {
              "id": "tsv",
              "title": "options.cli.value.tsv.title"
            },
            {
              "id": "parquet",
              "title": "options.cli.value.parquet.title"
            }
          ],
          "tooltip": "controls.cli.info_table_format.tooltip",
          "advancedOnly": true
        }
      ]
    },
    {
