{
  "id": "info-bam",
  "title": "pages.info-bam.title",
  "summary": "pages.info-bam.summary",
  "sidebarGroup": "sidebar.groups.convert",
  "sections": [
    {
      "id": "inputs",
      "title": "sections.info-bam.inputs.title",
      "iconName": "alignment-import",
      "textIcon": "📥",
      "controls": [
        {
          "id": "bam_path",
          "label": "controls.info-bam.inputs.bam_path.label",
          "kind": "path",
          "defaultDirectory": "{{dataset_library}}",
          "tooltip": "controls.info-bam.inputs.bam_path.tooltip"
        },
        {
          "id": "ref_path",
          "label": "controls.info-bam.inputs.ref_path.label",
          "kind": "path",
          "tooltip": "controls.info-bam.inputs.ref_path.tooltip",
          "advancedOnly": true
        },
        {
          "id": "out_dir",
          "label": "controls.info-bam.inputs.out_dir.label",
          "kind": "path",
          "tooltip": "controls.info-bam.inputs.out_dir.tooltip",
          "advancedOnly": true
        },
        {
          "id": "cram_version",
          "label": "controls.info-bam.inputs.cram_version.label",
          "kind": "dropdown",
          "value": "3.0",
          "tooltip": "controls.info-bam.inputs.cram_version.tooltip",
          "options": [
            {
              "id": "2.1",
              "title": "options.info-bam.inputs.cram_version.2.1.title"
            },
            {
              "id": "3.0",
              "title": "options.info-bam.inputs.cram_version.3.0.title",
              "selected": true
            },
            {
              "id": "3.1",
              "title": "options.info-bam.inputs.cram_version.3.1.title"
            }
          ],
          "advancedOnly": true
        }
      ]
    },
    {
      "id": "info-commands",
      "title": "sections.info-bam.info-commands.title",
      "actions": [
        {
          "id": "basic-info",
          "title": "actions.info-bam.info-commands.basic-info.title",
          "tooltip": "actions.info-bam.info-commands.basic-info.tooltip",
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "info",
              "--input",
              "{{bam_path}}"
            ],
            "optionalArguments": [
              [
                "--ref",
                "{{ref_path}}"
              ]
            ]
          }
        },
        {
          "id": "detailed-info",
          "title": "actions.info-bam.info-commands.detailed-info.title",
          "tooltip": "actions.info-bam.info-commands.detailed-info.tooltip",
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "info",
              "--input",
              "{{bam_path}}",
              "--detailed"
            ],
            "optionalArguments": [
              [
                "--ref",
                "{{ref_path}}"
              ],
              [
                "--format",
                "{{info_table_format}}"
              ]
            ]
          }
        },
        {
          "id": "coverage-sample",
          "title": "actions.info-bam.info-commands.coverage-sample.title",
          "tooltip": "actions.info-bam.info-commands.coverage-sample.tooltip",
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "info",
              "coverage-sample",
              "--input",
              "{{bam_path}}"
            ],
            "optionalArguments": [
              [
                "--region",
                "{{coverage_region}}"
              ],
              [
                "--format",
                "{{info_table_format}}"
              ]
            ]
          },
          "advancedOnly": true
        },
        {
          "id": "calculate-coverage",
          "title": "actions.info-bam.info-commands.calculate-coverage.title",
          "tooltip": "actions.info-bam.info-commands.calculate-coverage.tooltip",
          "estimatedDurationMinutes": 120,
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "info",
              "calculate-coverage",
              "--with-bins",
              "--input",
              "{{bam_path}}"
            ],
            "optionalArguments": [
              [
                "--format",
                "{{info_table_format}}"
              ]
            ]
          },
          "serverOperation": {
            "operation": "info/calculate-coverage",
            "parameters": {
              "input": "{{bam_path}}",
              "with_bins": true
            }
          },
          "visibleWhen": [
            {
              "placeholder": "coverage_done",
              "notEquals": "true"
            }
          ]
        },
        {
          "id": "calculate-coverage-shown",
          "title": "actions.info-bam.info-commands.calculate-coverage.title",
          "tooltip": "actions.info-bam.info-commands.calculate-coverage.shownTooltip",
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "info",
              "calculate-coverage",
              "--with-bins",
              "--input",
              "{{bam_path}}"
            ],
            "optionalArguments": [
              [
                "--format",
                "{{info_table_format}}"
              ]
            ]
          },
          "serverOperation": {
            "operation": "info/calculate-coverage",
            "parameters": {
              "input": "{{bam_path}}",
              "with_bins": true
            }
          },
          "visibleWhen": [
            {
              "placeholder": "coverage_done",
              "equals": "true"
            }
          ]
        },
        {
          "id": "coverage-by-bed",
          "title": "actions.cli.coverage-by-bed.title",
          "tooltip": "actions.cli.coverage-by-bed.tooltip",
          "advancedOnly": true,
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "info",
              "calculate-coverage",
              "--input",
              "{{bam_path}}",
              "--by",
              "{{coverage_by}}"
            ],
            "optionalArguments": [
              [
                "--min-depth",
                "{{coverage_min_depth}}"
              ]
            ]
          }
        }
      ],
      "iconName": "command-line",
      "textIcon": "▸",
      "dataSource": {
        "path": "scripts/coverage-state.py",
        "arguments": [
          "{{bam_path}}",
          "{{out_dir}}"
        ]
      },
      "controls": [
        {
          "id": "coverage_region",
          "label": "controls.cli.coverage_region.label",
          "kind": "text",
          "tooltip": "controls.cli.coverage_region.tooltip",
          "advancedOnly": true
        },
        {
          "id": "coverage_by",
          "label": "controls.cli.coverage_by.label",
          "kind": "path",
          "pathType": "file",
          "tooltip": "controls.cli.coverage_by.tooltip",
          "advancedOnly": true
        },
        {
          "id": "coverage_min_depth",
          "label": "controls.cli.coverage_min_depth.label",
          "kind": "text",
          "tooltip": "controls.cli.coverage_min_depth.tooltip",
          "advancedOnly": true
        },
