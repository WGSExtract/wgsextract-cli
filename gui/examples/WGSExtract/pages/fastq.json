{
  "id": "fastq",
  "title": "pages.fastq.title",
  "summary": "pages.fastq.summary",
  "sidebarGroup": "sidebar.groups.convert",
  "sections": [
    {
      "id": "fastq-inputs",
      "title": "sections.fastq.inputs.title",
      "iconName": "sequence-reads",
      "textIcon": "〰️",
      "controls": [
        {
          "id": "fastq_r1",
          "label": "controls.fastq.fastq-inputs.fastq_r1.label",
          "kind": "path",
          "defaultDirectory": "{{genome_library}}",
          "tooltip": "controls.fastq.fastq-inputs.fastq_r1.tooltip"
        },
        {
          "id": "fastq_r2",
          "label": "controls.fastq.fastq-inputs.fastq_r2.label",
          "kind": "path",
          "defaultDirectory": "{{genome_library}}",
          "tooltip": "controls.fastq.fastq-inputs.fastq_r2.tooltip"
        },
        {
          "id": "out_dir",
          "label": "controls.fastq.fastq-inputs.out_dir.label",
          "kind": "path",
          "tooltip": "controls.fastq.fastq-inputs.out_dir.tooltip",
          "advancedOnly": true
        },
        {
          "id": "fastqc_multiqc",
          "label": "controls.fastq.fastqc-multiqc.label",
          "kind": "checkboxGroup",
          "options": [
            {
              "id": "--multiqc",
              "title": "controls.fastq.fastqc-multiqc.label"
            }
          ],
          "tooltip": "controls.fastq.fastqc-multiqc.tooltip"
        }
      ],
      "actions": [
        {
          "id": "fastqc",
          "title": "actions.fastq.fastq-inputs.fastqc.title",
          "tooltip": "actions.fastq.fastq-inputs.fastqc.tooltip",
          "command": {
            "executable": "{{bundleRoot}}/scripts/fastqc-reads.sh",
            "arguments": [
              "{{fastq_r1}}"
            ],
            "optionalArguments": [
              [
                "--r2",
                "{{fastq_r2}}"
              ],
              [
                "--outdir",
                "{{out_dir}}"
              ],
              [
                "{{fastqc_multiqc}}"
              ]
            ]
          }
        },
        {
          "id": "fastp",
          "title": "actions.fastq.fastq-inputs.fastp.title",
          "tooltip": "actions.fastq.fastq-inputs.fastp.tooltip",
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "qc",
              "fastp",
              "--r1",
              "{{fastq_r1}}"
            ],
            "optionalArguments": [
              [
                "--r2",
                "{{fastq_r2}}"
              ],
              [
                "--outdir",
                "{{out_dir}}"
              ]
            ]
          }
        }
      ]
    },
    {
      "id": "multiqc",
      "title": "sections.fastq.post-v063.multiqc.title",
      "controls": [
        {
          "id": "multiqc_input",
          "label": "controls.fastq.post-v063.multiqc-file.label",
          "kind": "path",
          "pathType": "file",
          "tooltip": "controls.fastq.post-v063.multiqc-input.tooltip"
        },
        {
          "id": "multiqc_directory",
          "label": "controls.fastq.post-v063.multiqc-directory.label",
          "kind": "path",
          "pathType": "directory",
          "tooltip": "controls.fastq.post-v063.multiqc-input.tooltip"
        },
        {
          "id": "multiqc_force",
          "label": "controls.fastq.post-v063.multiqc-force.label",
          "kind": "checkboxGroup",
          "options": [
            {
              "id": "--force",
              "title": "controls.fastq.post-v063.multiqc-force.label"
            }
          ],
          "tooltip": "controls.fastq.post-v063.multiqc-force.tooltip"
        }
      ],
      "actions": [
        {
          "id": "multiqc",
          "title": "actions.fastq.post-v063.multiqc.title",
          "tooltip": "actions.fastq.post-v063.multiqc.tooltip",
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "qc",
              "multiqc",
              "--input",
              "{{multiqc_input}}"
            ],
            "optionalArguments": [
              [
                "--outdir",
                "{{out_dir}}"
              ],
              [
                "{{multiqc_force}}"
              ]
            ]
          }
        },
        {
          "id": "multiqc-directory",
          "title": "actions.fastq.post-v063.multiqc-directory.title",
          "tooltip": "actions.fastq.post-v063.multiqc.tooltip",
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "qc",
              "multiqc",
              "--input",
              "{{multiqc_directory}}"
            ],
            "optionalArguments": [
              [
                "--outdir",
                "{{out_dir}}"
              ],
              [
                "{{multiqc_force}}"
              ]
            ]
          }
        }
      ],
      "subsection": true,
      "advancedOnly": true
    },
    {
      "id": "pet-inputs",
      "title": "sections.pet-analysis.pet-inputs.title",
      "iconName": "paired-end",
      "textIcon": "🐾",
      "controls": [
        {
          "id": "pet_species",
          "label": "controls.pet-analysis.pet-inputs.pet_species.label",
          "kind": "dropdown",
          "tooltip": "controls.pet-analysis.pet-inputs.pet_species.tooltip",
          "value": "dog",
          "options": [
            {
              "id": "dog",
              "title": "options.pet-analysis.pet-inputs.pet_species.dog.title"
            },
            {
              "id": "cat",
              "title": "options.pet-analysis.pet-inputs.pet_species.cat.title"
            }
          ]
        },
        {
          "id": "pet_fastq_r1",
          "label": "controls.pet-analysis.pet-inputs.pet_fastq_r1.label",
          "kind": "path",
          "defaultDirectory": "{{genome_library}}",
          "tooltip": "controls.pet-analysis.pet-inputs.pet_fastq_r1.tooltip"
        },
        {
          "id": "pet_fastq_r2",
          "label": "controls.pet-analysis.pet-inputs.pet_fastq_r2.label",
          "kind": "path",
          "defaultDirectory": "{{genome_library}}",
          "tooltip": "controls.pet-analysis.pet-inputs.pet_fastq_r2.tooltip"
        },
        {
          "id": "pet_output_format",
          "label": "controls.pet-analysis.pet-inputs.pet_output_format.label",
          "kind": "dropdown",
          "tooltip": "controls.pet-analysis.pet-inputs.pet_output_format.tooltip",
          "value": "BAM",
          "options": [
            {
              "id": "BAM",
              "title": "options.pet-analysis.pet-inputs.pet_output_format.BAM.title"
            },
            {
              "id": "CRAM",
              "title": "options.pet-analysis.pet-inputs.pet_output_format.CRAM.title"
            }
          ]
        }
      ],
      "actions": [
        {
          "id": "pet-align",
          "title": "actions.pet-analysis.pet-inputs.pet-align.title",
          "tooltip": "actions.pet-analysis.pet-inputs.pet-align.tooltip",
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "pet-align",
              "--species",
              "{{pet_species}}",
              "--r1",
              "{{pet_fastq_r1}}",
              "--ref",
              "{{ref_path}}",
              "--format",
              "{{pet_output_format}}"
            ],
            "optionalArguments": [
              [
                "--outdir",
                "{{out_dir}}"
              ],
              [
                "--r2",
                "{{pet_fastq_r2}}"
              ]
            ]
          }
        }
      ],
      "advancedOnly": true
    }
  ],
  "iconName": "fastq",
  "textIcon": "📄"
}
