      "iconName": "bug-report",
      "textIcon": "🐞",
      "collapsed": true
    },
    {
      "id": "settings-paths",
      "title": "sections.settings.settings-paths.title",
      "controls": [
        {
          "id": "wgs_settings",
          "label": "controls.settings.settings-paths.wgs_settings.label",
          "kind": "configEditor",
          "tooltip": "controls.settings.settings-paths.wgs_settings.tooltip",
          "configFile": {
            "path": "{{usersWorkspace}}/config.toml",
            "previousPaths": [
              "{{bundleWorkspace}}/config.toml",
              "{{bundleWorkspace}}/settings/config.toml"
            ],
            "format": "toml",
            "bootstrap": {
              "mode": "mergeMissing",
              "script": {
                "path": "scripts/bootstrap-wgsextract-config.sh",
                "environment": {
                  "WGSEXTRACT_GUI_CLI_INSTALL": "bundled"
                }
              }
            }
          },
          "settings": [
            {
              "id": "out_dir",
              "key": "output_directory",
              "label": "controls.settings.settings-paths.out_dir.label",
              "kind": "path",
              "tooltip": "controls.settings.settings-paths.out_dir.tooltip",
              "placeholder": "controls.settings.settings-paths.out_dir.placeholder",
              "moveContents": true,
              "advancedOnly": true
            },
            {
              "id": "mygenomes_library",
              "key": "mygenomes_library",
              "label": "controls.settings.settings-paths.mygenomes_library.label",
              "kind": "path",
              "tooltip": "controls.settings.settings-paths.mygenomes_library.tooltip",
              "moveContents": true
            },
            {
              "id": "ref_path",
              "key": "reference_library",
              "label": "controls.settings.settings-paths.ref_path.label",
              "kind": "path",
              "tooltip": "controls.settings.settings-paths.ref_path.tooltip",
              "moveContents": true
            },
            {
              "id": "reference_genome_library",
              "key": "reference_genome_library",
              "label": "controls.settings.settings-paths.reference_genome_library.label",
              "kind": "path",
              "tooltip": "controls.settings.settings-paths.reference_genome_library.tooltip",
              "moveContents": true
            },
            {
              "id": "temp_directory",
              "key": "temp_directory",
              "label": "controls.settings.post-v063.temp.label",
              "kind": "path",
              "tooltip": "controls.settings.post-v063.temp.tooltip",
              "moveContents": true
            },
            {
              "id": "log_dir",
              "key": "log_dir",
              "label": "controls.settings.post-v063.logs.label",
              "kind": "path",
              "tooltip": "controls.settings.post-v063.logs.tooltip",
              "moveContents": true
            },
            {
              "id": "atomic_outputs",
              "key": "atomic_outputs",
              "label": "controls.settings.post-v063.atomic.label",
              "kind": "toggle",
              "value": false,
              "tooltip": "controls.settings.post-v063.atomic.tooltip"
            },
            {
              "id": "keep_awake",
              "key": "keep_awake",
              "label": "controls.settings.post-v063.awake.label",
              "kind": "toggle",
              "value": false,
              "tooltip": "controls.settings.post-v063.awake.tooltip"
            },
            {
              "id": "allow_reference_downloads",
              "key": "allow_reference_downloads",
              "label": "controls.settings.privacy.downloads.label",
              "kind": "toggle",
              "value": false,
              "tooltip": "controls.settings.privacy.downloads.tooltip"
            }
          ]
        }
