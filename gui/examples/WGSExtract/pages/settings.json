{
  "id": "settings",
  "title": "pages.settings.title",
  "summary": "pages.settings.summary",
  "sidebarPlacement": "bottom",
  "sections": [
    {
      "id": "settings-paths",
      "title": "sections.settings.settings-paths.title",
      "controls": [
        {
          "id": "wgs_settings",
          "label": "controls.settings.settings-paths.wgs_settings.label",
          "kind": "configEditor",
          "tooltip": "controls.settings.settings-paths.wgs_settings.tooltip",
          "configFile": {
            "path": "{{bundleWorkspace}}/config.toml",
            "previousPaths": ["{{bundleWorkspace}}/settings/config.toml"],
            "format": "toml",
            "bootstrap": {
              "mode": "mergeMissing",
              "script": {
                "path": "scripts/bootstrap-wgsextract-config.sh"
              }
            }
          },
          "settings": [
            {
              "id": "temp_directory",
              "key": "temp_directory",
              "label": "controls.settings.post-v063.temp.label",
              "kind": "path",
              "tooltip": "controls.settings.post-v063.temp.tooltip"
            },
            {
              "id": "log_dir",
              "key": "log_dir",
              "label": "controls.settings.post-v063.logs.label",
              "kind": "path",
              "tooltip": "controls.settings.post-v063.logs.tooltip"
            },
            {
              "id": "atomic_outputs",
              "key": "atomic_outputs",
              "label": "controls.settings.post-v063.atomic.label",
              "kind": "toggle",
              "value": false,
              "tooltip": "controls.settings.post-v063.atomic.tooltip"
            },
            {
              "id": "keep_awake",
              "key": "keep_awake",
              "label": "controls.settings.post-v063.awake.label",
              "kind": "toggle",
              "value": false,
              "tooltip": "controls.settings.post-v063.awake.tooltip"
            },
            {
              "id": "out_dir",
              "key": "output_directory",
              "label": "controls.settings.settings-paths.out_dir.label",
              "kind": "path",
              "tooltip": "controls.settings.settings-paths.out_dir.tooltip"
            },
            {
              "id": "ref_path",
              "key": "reference_library",
              "label": "controls.settings.settings-paths.ref_path.label",
              "kind": "path",
              "tooltip": "controls.settings.settings-paths.ref_path.tooltip"
            },
            {
              "id": "reference_genome_library",
              "key": "reference_genome_library",
              "label": "controls.settings.settings-paths.reference_genome_library.label",
              "kind": "path",
              "tooltip": "controls.settings.settings-paths.reference_genome_library.tooltip"
            },
            {
              "id": "dataset_library",
              "key": "dataset_library",
              "label": "controls.settings.settings-paths.dataset_library.label",
              "kind": "path",
              "tooltip": "controls.settings.settings-paths.dataset_library.tooltip"
            },
            {
              "id": "ref_fasta",
              "key": "reference_fasta",
              "label": "controls.settings.settings-paths.ref_fasta.label",
              "kind": "dropdown",
              "tooltip": "controls.settings.settings-paths.ref_fasta.tooltip",
              "dataSource": {
                "path": "scripts/list-reference-genomes.py",
                "arguments": [
                  "options",
                  "{{ref_path}}",
                  "{{reference_genome_library}}"
                ]
              }
            },
            {
              "id": "vcf_path",
              "key": "default_input_vcf",
              "label": "controls.settings.settings-paths.vcf_path.label",
              "kind": "path",
              "defaultDirectory": "{{dataset_library}}",
              "tooltip": "controls.settings.settings-paths.vcf_path.tooltip"
            },
            {
              "id": "mother_vcf_path",
              "key": "mother_vcf_path",
              "label": "controls.settings.settings-paths.mother_vcf_path.label",
              "kind": "path",
              "defaultDirectory": "{{dataset_library}}",
              "tooltip": "controls.settings.settings-paths.mother_vcf_path.tooltip"
            },
            {
              "id": "father_vcf_path",
              "key": "father_vcf_path",
              "label": "controls.settings.settings-paths.father_vcf_path.label",
              "kind": "path",
              "defaultDirectory": "{{dataset_library}}",
              "tooltip": "controls.settings.settings-paths.father_vcf_path.tooltip"
            },
            {
              "id": "haplogrep_path",
              "key": "haplogrep_executable",
              "label": "controls.settings.settings-paths.haplogrep_path.label",
              "kind": "path",
              "tooltip": "controls.settings.settings-paths.haplogrep_path.tooltip"
            }
          ]
        }
      ],
      "iconName": "workspace",
      "textIcon": "🗂️",
      "advancedOnly": true
    },
    {
      "id": "dependency-checks",
      "title": "sections.settings.dependency-checks.title",
      "summary": "sections.settings.dependency-checks.summary",
      "actions": [
        {
          "id": "deps-check",
          "title": "actions.settings.dependency-checks.deps-check.title",
          "tooltip": "actions.settings.dependency-checks.deps-check.tooltip",
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "deps",
              "check"
            ],
            "optionalArguments": [
              [
                "--tool",
                "{{deps_tool}}"
              ]
            ]
          }
        }
      ],
      "iconName": "precheck",
      "textIcon": "☑️",
      "controls": [
        {
          "id": "deps_tool",
          "label": "controls.cli.deps_tool.label",
          "kind": "text",
          "tooltip": "controls.cli.deps_tool.tooltip",
          "advancedOnly": true
        }
      ]
    },
    {
      "id": "report-issue",
      "title": "sections.settings.v066.report-issue.title",
      "subtitle": "sections.settings.v066.report-issue.subtitle",
      "controls": [
        {
          "id": "report_last_failed",
          "label": "controls.settings.v066.report-last-failed.label",
          "kind": "checkboxGroup",
          "options": [
            {
              "id": "--last-failed",
              "title": "controls.settings.v066.report-last-failed.label"
            }
          ],
          "tooltip": "controls.settings.v066.report-last-failed.tooltip"
        },
        {
          "id": "report_description",
          "label": "controls.settings.v066.report-description.label",
          "kind": "text",
          "tooltip": "controls.settings.v066.report-description.tooltip"
        },
        {
          "id": "report_title",
          "label": "controls.cli.report_title.label",
          "kind": "text",
          "tooltip": "controls.cli.report_title.tooltip",
          "advancedOnly": true
        },
        {
          "id": "report_log_lines",
          "label": "controls.cli.report_log_lines.label",
          "kind": "text",
          "tooltip": "controls.cli.report_log_lines.tooltip",
          "advancedOnly": true
        },
        {
          "id": "report_max_url_length",
          "label": "controls.cli.report_max_url_length.label",
          "kind": "text",
          "tooltip": "controls.cli.report_max_url_length.tooltip",
          "advancedOnly": true
        }
      ],
      "actions": [
        {
          "id": "report-issue",
          "title": "actions.settings.v066.report-issue.title",
          "tooltip": "actions.settings.v066.report-issue.tooltip",
          "visibleWhen": [
            {
              "placeholder": "report_last_failed",
              "notEquals": "--last-failed"
            }
          ],
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "report-issue",
              "--print"
            ],
            "optionalArguments": [
              [
                "--run",
                "{{lastResultDocumentPath}}"
              ],
              [
                "--description",
                "{{report_description}}"
              ],
              [
                "--title",
                "{{report_title}}"
              ],
              [
                "--log-lines",
                "{{report_log_lines}}"
              ],
              [
                "--max-url-length",
                "{{report_max_url_length}}"
              ]
            ]
          }
        },
        {
          "id": "report-issue-last-failed",
          "title": "actions.settings.v066.report-issue.title",
          "tooltip": "actions.settings.v066.report-issue.tooltip",
          "visibleWhen": [
            {
              "placeholder": "report_last_failed",
              "equals": "--last-failed"
            },
            {
              "placeholder": "lastFailedResultDocumentPath",
              "exists": true
            }
          ],
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "report-issue",
              "--print"
            ],
            "optionalArguments": [
              [
                "--run",
                "{{lastFailedResultDocumentPath}}"
              ],
              [
                "--description",
                "{{report_description}}"
              ],
              [
                "--title",
                "{{report_title}}"
              ],
              [
                "--log-lines",
                "{{report_log_lines}}"
              ],
              [
                "--max-url-length",
                "{{report_max_url_length}}"
              ]
            ]
          }
        },
        {
          "id": "report-issue-cli-last-failed",
          "title": "actions.settings.v066.report-issue.title",
          "tooltip": "actions.settings.v066.report-issue.tooltip",
          "visibleWhen": [
            {
              "placeholder": "report_last_failed",
              "equals": "--last-failed"
            },
            {
              "placeholder": "lastFailedResultDocumentPath",
              "exists": false
            }
          ],
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "report-issue",
              "--print"
            ],
            "optionalArguments": [
              [
                "--last-failed"
              ],
              [
                "--description",
                "{{report_description}}"
              ],
              [
                "--title",
                "{{report_title}}"
              ],
              [
                "--log-lines",
                "{{report_log_lines}}"
              ],
              [
                "--max-url-length",
                "{{report_max_url_length}}"
              ]
            ]
          }
        },
        {
          "id": "report-issue-open",
          "title": "actions.settings.v066.report-issue-open.title",
          "tooltip": "actions.settings.v066.report-issue-open.tooltip",
          "confirm": {
            "title": "actions.settings.v066.report-issue-open.confirm.title",
            "message": "actions.settings.v066.report-issue-open.confirm.message",
            "confirmButtonTitle": "actions.settings.v066.report-issue-open.confirm.confirmButtonTitle",
            "cancelButtonTitle": "actions.settings.v066.report-issue-open.confirm.cancelButtonTitle"
          },
          "visibleWhen": [
            {
              "placeholder": "report_last_failed",
              "notEquals": "--last-failed"
            }
          ],
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "report-issue",
              "--open"
            ],
            "optionalArguments": [
              [
                "--run",
                "{{lastResultDocumentPath}}"
              ],
              [
                "--description",
                "{{report_description}}"
              ],
              [
                "--title",
                "{{report_title}}"
              ],
              [
                "--log-lines",
                "{{report_log_lines}}"
              ],
              [
                "--max-url-length",
                "{{report_max_url_length}}"
              ]
            ]
          }
        },
        {
          "id": "report-issue-open-last-failed",
          "title": "actions.settings.v066.report-issue-open.title",
          "tooltip": "actions.settings.v066.report-issue-open.tooltip",
          "confirm": {
            "title": "actions.settings.v066.report-issue-open.confirm.title",
            "message": "actions.settings.v066.report-issue-open.confirm.message",
            "confirmButtonTitle": "actions.settings.v066.report-issue-open.confirm.confirmButtonTitle",
            "cancelButtonTitle": "actions.settings.v066.report-issue-open.confirm.cancelButtonTitle"
          },
          "visibleWhen": [
            {
              "placeholder": "report_last_failed",
              "equals": "--last-failed"
            },
            {
              "placeholder": "lastFailedResultDocumentPath",
              "exists": true
            }
          ],
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "report-issue",
              "--open"
            ],
            "optionalArguments": [
              [
                "--run",
                "{{lastFailedResultDocumentPath}}"
              ],
              [
                "--description",
                "{{report_description}}"
              ],
              [
                "--title",
                "{{report_title}}"
              ],
              [
                "--log-lines",
                "{{report_log_lines}}"
              ],
              [
                "--max-url-length",
                "{{report_max_url_length}}"
              ]
            ]
          }
        },
        {
          "id": "report-issue-open-cli-last-failed",
          "title": "actions.settings.v066.report-issue-open.title",
          "tooltip": "actions.settings.v066.report-issue-open.tooltip",
          "confirm": {
            "title": "actions.settings.v066.report-issue-open.confirm.title",
            "message": "actions.settings.v066.report-issue-open.confirm.message",
            "confirmButtonTitle": "actions.settings.v066.report-issue-open.confirm.confirmButtonTitle",
            "cancelButtonTitle": "actions.settings.v066.report-issue-open.confirm.cancelButtonTitle"
          },
          "visibleWhen": [
            {
              "placeholder": "report_last_failed",
              "equals": "--last-failed"
            },
            {
              "placeholder": "lastFailedResultDocumentPath",
              "exists": false
            }
          ],
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "report-issue",
              "--open"
            ],
            "optionalArguments": [
              [
                "--last-failed"
              ],
              [
                "--description",
                "{{report_description}}"
              ],
              [
                "--title",
                "{{report_title}}"
              ],
              [
                "--log-lines",
                "{{report_log_lines}}"
              ],
              [
                "--max-url-length",
                "{{report_max_url_length}}"
              ]
            ]
          }
        }
      ],
      "iconName": "precheck",
      "textIcon": "🐞"
    }
  ],
  "iconName": "settings",
  "textIcon": "⚙️"
}
