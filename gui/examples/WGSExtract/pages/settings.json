            "optionalArguments": [
              [
                "--run",
                "{{lastResultDocumentPath}}"
              ],
              [
                "--description",
                "{{report_description}}"
              ],
              [
                "--title",
                "{{report_title}}"
              ],
              [
                "--log-lines",
                "{{report_log_lines}}"
              ],
              [
                "--max-url-length",
                "{{report_max_url_length}}"
              ]
