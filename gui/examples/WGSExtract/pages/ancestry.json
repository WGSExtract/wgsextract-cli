{
  "id": "ancestry",
  "title": "pages.ancestry.title",
  "summary": "pages.ancestry.summary",
  "sidebarGroup": "sidebar.groups.analyze",
  "sections": [
    {
      "id": "ancestry-inputs",
      "title": "sections.ancestry.ancestry-inputs.title",
      "iconName": "ancestry-tree",
      "textIcon": "🌳",
      "controls": [
        {
          "id": "lineage_tree_links",
          "label": "controls.ancestry.post-v063.tree-links.label",
          "kind": "checkboxGroup",
          "options": [
            {
              "id": "--tree-links",
              "title": "controls.ancestry.post-v063.tree-links.label"
            }
          ],
          "tooltip": "controls.ancestry.post-v063.tree-links.tooltip"
        },
        {
          "id": "bam_path",
          "label": "controls.ancestry.ancestry-inputs.bam_path.label",
          "kind": "path",
          "defaultDirectory": "{{genome_library}}",
          "tooltip": "controls.ancestry.ancestry-inputs.bam_path.tooltip"
        },
        {
          "id": "yleaf_pos",
          "label": "controls.ancestry.ancestry-inputs.yleaf_pos.label",
          "kind": "path",
          "tooltip": "controls.ancestry.ancestry-inputs.yleaf_pos.tooltip"
        },
        {
          "id": "yleaf_tree",
          "label": "controls.ancestry.ancestry-inputs.yleaf_tree.label",
          "kind": "dropdown",
          "tooltip": "controls.ancestry.ancestry-inputs.yleaf_tree.tooltip",
          "options": [
            {
              "id": "",
              "title": "options.ancestry.ancestry-inputs.yleaf_tree.default.title"
            },
            {
              "id": "yfull",
              "title": "options.ancestry.ancestry-inputs.yleaf_tree.yfull.title"
            },
            {
              "id": "yfull_v10",
              "title": "options.ancestry.ancestry-inputs.yleaf_tree.yfull_v10.title"
            },
            {
              "id": "ftdna",
              "title": "options.ancestry.ancestry-inputs.yleaf_tree.ftdna.title"
            },
            {
              "id": "isogg",
              "title": "options.ancestry.ancestry-inputs.yleaf_tree.isogg.title"
            }
          ]
        },
        {
          "id": "yleaf_ancient",
          "label": "controls.ancestry.ancestry-inputs.yleaf_ancient.label",
          "kind": "checkboxGroup",
          "options": [
            {
              "id": "--ancient",
              "title": "controls.ancestry.ancestry-inputs.yleaf_ancient.label"
            }
          ],
          "tooltip": "controls.ancestry.ancestry-inputs.yleaf_ancient.tooltip"
        },
        {
          "id": "yleaf_no_ref_inference",
          "label": "controls.ancestry.ancestry-inputs.yleaf_no_ref_inference.label",
          "kind": "checkboxGroup",
          "options": [
            {
              "id": "--no-ref-inference",
              "title": "controls.ancestry.ancestry-inputs.yleaf_no_ref_inference.label"
            }
          ],
          "tooltip": "controls.ancestry.ancestry-inputs.yleaf_no_ref_inference.tooltip"
        },
        {
          "id": "haplogrep_path",
          "label": "controls.ancestry.ancestry-inputs.haplogrep_path.label",
          "kind": "path",
          "tooltip": "controls.ancestry.ancestry-inputs.haplogrep_path.tooltip"
        },
        {
          "id": "y_str_panel",
          "label": "controls.ancestry.v066.y-str-panel.label",
          "kind": "dropdown",
          "tooltip": "controls.ancestry.v066.y-str-panel.tooltip",
          "options": [
            {
              "id": "",
              "title": "options.ancestry.v066.y-str-panel.default.title"
            },
            {
              "id": "Y-12",
              "title": "options.ancestry.v066.y-str-panel.y12.title"
            },
            {
              "id": "Y-25",
              "title": "options.ancestry.v066.y-str-panel.y25.title"
            },
            {
              "id": "Y-37",
              "title": "options.ancestry.v066.y-str-panel.y37.title"
            },
            {
              "id": "Y-67",
              "title": "options.ancestry.v066.y-str-panel.y67.title"
            },
            {
              "id": "Y-111",
              "title": "options.ancestry.v066.y-str-panel.y111.title"
            },
            {
              "id": "PPY23",
              "title": "options.ancestry.v066.y-str-panel.ppy23.title"
            },
            {
              "id": "YfilerPlus",
              "title": "options.ancestry.v066.y-str-panel.yfiler.title"
            },
            {
              "id": "all",
              "title": "options.ancestry.v066.y-str-panel.all.title"
            }
          ]
        }
      ],
      "actions": [
        {
          "id": "run-yleaf",
          "title": "actions.ancestry.ancestry-inputs.run-yleaf.title",
          "tooltip": "actions.ancestry.ancestry-inputs.run-yleaf.tooltip",
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "lineage",
              "y-haplogroup",
              "--input",
              "{{bam_path}}"
            ],
            "optionalArguments": [
              [
                "{{lineage_tree_links}}"
              ],
              [
                "--pos-file",
                "{{yleaf_pos}}"
              ],
              [
                "--tree",
                "{{yleaf_tree}}"
              ],
              [
                "{{yleaf_ancient}}"
              ],
              [
                "{{yleaf_no_ref_inference}}"
              ]
            ]
          }
        },
        {
          "id": "run-haplogrep",
          "title": "actions.ancestry.ancestry-inputs.run-haplogrep.title",
          "tooltip": "actions.ancestry.ancestry-inputs.run-haplogrep.tooltip",
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "lineage",
              "mt-haplogroup",
              "--input",
              "{{bam_path}}",
              "--haplogrep-path",
              "{{haplogrep_path}}"
            ],
            "optionalArguments": [
              [
                "{{lineage_tree_links}}"
              ],
              [
                "--outdir",
                "{{out_dir}}"
              ]
            ]
          }
        },
        {
          "id": "run-y-str",
          "title": "actions.ancestry.v066.y-str.title",
          "tooltip": "actions.ancestry.v066.y-str.tooltip",
          "command": {
            "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
            "arguments": [
              "lineage",
              "y-str",
              "--input",
              "{{bam_path}}"
            ],
            "optionalArguments": [
              [
                "--panel",
                "{{y_str_panel}}"
              ],
              [
                "--ref",
                "{{ref_path}}"
              ],
              [
                "--outdir",
                "{{out_dir}}"
              ]
            ]
          }
        }
      ]
    }
  ],
  "iconName": "ancestry",
  "textIcon": "👥"
}
