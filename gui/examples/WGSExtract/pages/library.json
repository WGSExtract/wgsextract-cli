          "label": "controls.library.databases-tools.reference_data.label",
          "kind": "libraryList",
          "tooltip": "controls.library.databases-tools.reference_data.tooltip",
          "dataSource": {
            "path": "scripts/run-wgsextract.sh",
            "arguments": [
              "--json",
              "ref",
              "status"
            ],
            "optionalArguments": [
              [
                "--ref",
                "{{ref_path}}"
              ],
              [
                "--mygenomes-library",
                "{{mygenomes_library}}"
              ]
            ],
            "transform": {
              "module": "transforms/reference-data.mjs",
              "export": "items"
            }
          },
          "columns": [
            {
              "id": "name",
              "title": "columns.library.databases-tools.reference_data.name.title"
            },
            {
              "id": "version",
              "title": "columns.library.databases-tools.reference_data.version.title"
            },
            {
              "id": "build",
              "title": "columns.library.databases-tools.reference_data.build.title"
            },
            {
              "id": "usedFor",
              "title": "columns.library.databases-tools.reference_data.usedFor.title"
            },
            {
              "id": "size",
              "title": "columns.library.databases-tools.reference_data.size.title"
            }
          ],
          "rowTemplate": {
            "id": "{{id}}",
            "title": "{{name}}",
            "status": "{{status}}",
            "values": {
              "name": "{{name}}",
              "version": "{{version}}",
              "build": "{{build}}",
              "usedFor": "{{usedFor}}",
              "size": "{{size}}"
            }
          },
