{
  "id": "wgs-extract",
  // Keep this bundle version in sync with scripts/wgsextract-release-tag.txt so installer names match the bundled WGSExtract CLI release.
  "version": "0.9.0",
  // The settings file and the folders the user manages (outputs, libraries) grow large and belong to the user,
  // so they are kept in plain sight in {{usersWorkspace}}, apart from the app's hidden {{bundleWorkspace}}.
  "defaultUsersWorkspace": "~/wgs-extract",
  "displayName": "bundle.displayName",
  "summary": "bundle.summary",
  "iconName": "fasta",
  "textIcon": "🧬",
  "iconPath": "Assets/icon.png",
  "sidebarIconStyle": "automatic",
  "terminalTextDirection": "ltr",
  "setup": {
    "initialInstallSizeGB": 6,
    "steps": [
      {
        "id": "xcode-command-line-tools",
        "kind": "setupScript",
        "label": "setup.xcode-command-line-tools.label",
        "value": "scripts/check-xcode-command-line-tools.sh",
        "platforms": [
          "macos"
        ]
      },
      {
        "id": "pixi",
        "kind": "setupScript",
        "label": "setup.pixi.label",
        "value": "scripts/check-preinstalled-pixi.sh"
      },
      {
        "id": "install-wgsextract",
        "kind": "setupScript",
        "label": "setup.install-wgsextract.label",
        "value": "scripts/setup-wgsextract-pixi.sh",
        "arguments": [],
        "platforms": [
          "posix"
        ],
        "toolName": "WGS Extract CLI",
        "toolVersionFile": "scripts/wgsextract-release-tag.txt",
        "environment": {
          "WGSEXTRACT_INSTALL_DIR": "{{appData}}/runtime/wgsextract-cli"
        }
      },
      {
        "id": "install-wgsextract-windows",
        "kind": "setupScript",
        "label": "setup.install-wgsextract-windows.label",
        "value": "scripts/setup-wgsextract-pixi.sh",
        "arguments": [],
        // No elevation: setup installs for this user only. Elevating a standard user's setup asks for an
        // administrator's password and then runs it as that administrator.
        "platforms": [
          "windows"
        ],
        "toolName": "WGS Extract CLI",
        "toolVersionFile": "scripts/wgsextract-release-tag.txt",
        "environment": {
          "WGSEXTRACT_INSTALL_DIR": "{{appData}}/runtime/wgsextract-cli"
        }
      },
      {
        "id": "wgsextract-cli",
        "kind": "pathTool",
        "label": "setup.wgsextract.label",
        "value": "{{appData}}/runtime/wgsextract-cli/bin/wgsextract",
        "platforms": [
          "posix"
        ]
      },
      {
        "id": "wgsextract-cli-windows",
        "kind": "pathTool",
        "label": "setup.wgsextract.label",
        "value": "{{appData}}/runtime/wgsextract-cli/bin/wgsextract.cmd",
        "platforms": [
          "windows"
        ]
      },
      {
        "id": "bootstrap-reference-library",
        "kind": "setupScript",
        "label": "Download bootstrap reference library",
        "value": "scripts/bootstrap-reference-library.sh",
        "arguments": []
      }
    ]
  },
  "uninstall": {
    "steps": [
      {
        "id": "cleanup-wgsextract-runtime",
        "kind": "setupScript",
        "label": "Cleanup WGS Extract runtime",
        "value": "scripts/uninstall-wgsextract.sh"
      }
    ]
  },
  "resultDocument": {
    "format": "wgsextract.result/1",
    "executables": [
      "{{bundleRoot}}/scripts/run-wgsextract.sh"
    ],
    "arguments": [
      "--result-file",
      "{{resultDocumentPath}}"
    ],
    "cardArguments": [
      "--card"
    ]
  },
  "jobServer": {
    "command": {
      "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
      "arguments": [
        "--parent-pid",
        "{{appPid}}",
        "serve",
        "--listen",
        "127.0.0.1",
        "--port",
        "0",
        "--ready-json",
        "--allow",
        "{{home}}"
      ]
    }
  },
  // Before an action runs, `wgsextract ref needs` names the reference genome, annotation data or optional tool its command
  // line needs that isn't installed; the app then offers to install it (`wgsextract ref library --install <code>`,
  // `wgsextract deps install <tool>` and the like).
  "prerequisites": {
    "command": {
      "executable": "{{bundleRoot}}/scripts/run-wgsextract.sh",
      "arguments": [
        "ref",
        "needs",
        "--report-json",
        "--"
      ]
    },
    "executables": {
      "{{bundleRoot}}/scripts/run-wgsextract.sh": []
    },
    "kindLabels": {
      "genome": "prerequisites.kinds.genome",
      "annotation": "prerequisites.kinds.annotation",
      "tool": "prerequisites.kinds.tool"
    }
  },
  "pages": [
    "fastq.json",
    "info-bam.json",
    "vcf.json",
    "extract.json",
    "microarray.json",
    "ancestry.json",
    "annotate.json",
    "workflows.json",
    "datasets.json",
    "library.json",
    "reference-genomes.json",
    "tools.json",
    "settings.json"
  ]
}
