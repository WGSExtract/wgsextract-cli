{
  "name": "fresh install - default tools with hg19 and downloaded benchmark genome",
  "inputs": {
    "fieldValues": {
      "bam_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/HG00096.hg19-mini.bam",
      "cram_version": "3.0",
      "extract_extra": "0.25",
      "extract_region": "20:1-250000",
      "fastq_output_format": "BAM",
      "fastq_r1": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/HG00096.hg19-mini_R1.fastq.gz",
      "fastq_r2": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/HG00096.hg19-mini_R2.fastq.gz",
      "mygenomes_library": "{{usersWorkspace}}/mygenomes",
      "haplogrep_path": "haplogrep",
      "out_dir": "{{usersWorkspace}}/output",
      "realign_bam": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/HG00096.hg19-mini.cram",
      "realign_ref": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz",
      "ref_fasta": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz",
      "ref_path": "{{usersWorkspace}}/reference",
      "vcf_filter_expr": "QUAL>=0",
      "vcf_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/HG00096.hg19-mini.vcf.gz",
      "vcf_region": "20",
      "vcf_child": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/HG00096.hg19-mini.vcf.gz",
      "vcf_mother": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/HG00096.hg19-mini.vcf.gz",
      "vcf_father": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/HG00096.hg19-mini.vcf.gz"
    },
    "checkedOptions": {
      "lineage_download": ["--download"],
      "microarray_download": ["--download"],
      "microarray_formats": [
        "23andme_v5",
        "ancestry_v2",
        "ftdna_v3",
        "myheritage_v2"
      ]
    }
  },
  "steps": [
    {
      "id": "fresh-install-setup",
      "kind": "setup",
      "timeoutSeconds": 7200
    },
    {
      "id": "download-test-genome",
      "kind": "action",
      "pageID": "datasets",
      "sectionID": "test-dataset",
      "actionID": "test-dataset-download",
      "inputs": {
        "fieldValues": {
          "library.testGenomeInstalled": "false"
        }
      },
      "requiredOutput": [
        "Test genome: installed"
      ],
      "timeoutSeconds": 1800
    },
    {
      "id": "download-hg19",
      "kind": "action",
      "pageID": "reference-genomes",
      "sectionID": "genome-management",
      "controlID": "reference_genomes",
      "actionID": "ref-download",
      "rowID": "hg19-UCSC-hg19.fa.gz",
      "rowValues": {
        "tag": "hg19h",
        "code": "hg19",
        "final": "hg19.fa.gz",
        "name": "hg19",
        "ref": "{{usersWorkspace}}/genomes/hg19.fa.gz",
        "source": "UCSC",
        "status": "missing"
      },
      "timeoutSeconds": 14400
    },
    {
      "id": "verify-hg19",
      "kind": "action",
      "pageID": "reference-genomes",
      "sectionID": "genome-management",
      "controlID": "reference_genomes",
      "actionID": "ref-verify",
      "rowID": "hg19-UCSC-hg19.fa.gz",
      "rowValues": {
        "tag": "hg19h",
        "code": "hg19",
        "final": "hg19.fa.gz",
        "name": "hg19",
        "ref": "{{usersWorkspace}}/genomes/hg19.fa.gz",
        "source": "UCSC",
        "status": "installed"
      },
      "timeoutSeconds": 1800
    },
    {
      "id": "reference-dropdown-fastq",
      "kind": "dataSource",
      "pageID": "extract",
      "sectionID": "fastq-align",
      "controlID": "ref_fasta",
      "minimumOptions": 1,
      "requiredOutput": [
        "hg19 (Yoruba"
      ]
    },
    {
      "id": "reference-dropdown-realign",
      "kind": "dataSource",
      "pageID": "extract",
      "sectionID": "realign-commands",
      "controlID": "realign_ref",
      "minimumOptions": 1,
      "requiredOutput": [
        "hg19 (Yoruba"
      ]
    },
    {
      "id": "reference-dropdown-settings",
      "kind": "dataSource",
      "pageID": "settings",
      "sectionID": "settings-paths",
      "controlID": "wgs_settings",
      "settingID": "ref_fasta",
      "minimumOptions": 1,
      "requiredOutput": [
        "hg19 (Yoruba"
      ]
    },
    {
      "id": "reference-library-list",
      "kind": "dataSource",
      "pageID": "reference-genomes",
      "sectionID": "genome-management",
      "controlID": "reference_genomes",
      "requiredOutput": [
        "\"status\": \"installed\""
      ]
    },
    {
      "id": "count-hg19-ns",
      "kind": "action",
      "pageID": "reference-genomes",
      "sectionID": "genome-management",
      "controlID": "reference_genomes",
      "actionID": "ref-count-ns",
      "rowID": "hg19-UCSC-hg19.fa.gz",
      "rowValues": {
        "tag": "hg19h",
        "code": "hg19",
        "final": "hg19.fa.gz",
        "name": "hg19",
        "ref": "{{usersWorkspace}}/genomes/hg19.fa.gz",
        "source": "UCSC",
        "status": "installed"
      },
      "timeoutSeconds": 3600
    },
    {
      "id": "tools-list",
      "kind": "dataSource",
      "pageID": "tools",
      "sectionID": "tool-management",
      "controlID": "tools",
      "requiredOutput": [
        "\"id\": \"samtools\""
      ],
      "timeoutSeconds": 300
    },
    {
      "id": "basic-bam-info",
      "kind": "action",
      "pageID": "info-bam",
      "sectionID": "info-commands",
      "actionID": "basic-info",
      "inputs": {
        "fieldValues": {
          "ref_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz"
        }
      },
      "expectedResult": { "status": "ok" },
      "timeoutSeconds": 300
    },
    {
      "id": "detailed-bam-info",
      "kind": "action",
      "pageID": "info-bam",
      "sectionID": "info-commands",
      "actionID": "detailed-info",
      "inputs": {
        "fieldValues": {
          "ref_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz"
        }
      },
      "timeoutSeconds": 600
    },
    {
      "id": "coverage-sample",
      "kind": "action",
      "pageID": "info-bam",
      "sectionID": "info-commands",
      "actionID": "coverage-sample",
      "timeoutSeconds": 600
    },
    {
      "id": "calculate-coverage",
      "kind": "action",
      "pageID": "info-bam",
      "sectionID": "info-commands",
      "actionID": "calculate-coverage",
      "timeoutSeconds": 900
    },
    {
      "id": "bam-to-cram",
      "kind": "action",
      "pageID": "info-bam",
      "sectionID": "bam-commands",
      "actionID": "bam-to-cram",
      "inputs": {
        "fieldValues": {
          "ref_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz"
        }
      },
      "expectedResult": { "status": "ok", "outputs": ["alignment"] },
      "timeoutSeconds": 900
    },
    {
      "id": "cram-to-bam",
      "kind": "action",
      "pageID": "info-bam",
      "sectionID": "bam-commands",
      "actionID": "cram-to-bam",
      "inputs": {
        "fieldValues": {
          "bam_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/HG00096.hg19-mini.cram",
          "ref_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz"
        }
      },
      "timeoutSeconds": 900
    },
    {
      "id": "bam-unsort",
      "kind": "action",
      "pageID": "info-bam",
      "sectionID": "bam-commands",
      "actionID": "bam-unsort",
      "timeoutSeconds": 600
    },
    {
      "id": "bam-sort",
      "kind": "action",
      "pageID": "info-bam",
      "sectionID": "bam-commands",
      "actionID": "bam-sort",
      "inputs": {
        "fieldValues": {
          "bam_path": "{{usersWorkspace}}/output/HG00096.hg19-mini_unsorted.bam",
          "ref_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz"
        }
      },
      "timeoutSeconds": 900
    },
    {
      "id": "bam-index",
      "kind": "action",
      "pageID": "info-bam",
      "sectionID": "bam-commands",
      "actionID": "bam-index",
      "inputs": {
        "fieldValues": {
          "bam_path": "{{usersWorkspace}}/output/HG00096.hg19-mini_unsorted_sorted.bam"
        }
      },
      "timeoutSeconds": 300
    },
    {
      "id": "bam-unalign",
      "kind": "action",
      "pageID": "info-bam",
      "sectionID": "bam-commands",
      "actionID": "bam-unalign",
      "timeoutSeconds": 900
    },
    {
      "id": "realign-cram",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "realign-commands",
      "actionID": "realign",
      "timeoutSeconds": 1800
    },
    {
      "id": "align-fastq-from-info-page",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "fastq-align",
      "actionID": "align",
      "timeoutSeconds": 1800
    },
    {
      "id": "align-fastq-page",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "fastq-align",
      "actionID": "align",
      "timeoutSeconds": 1800
    },
    {
      "id": "fastqc",
      "kind": "action",
      "pageID": "fastq",
      "sectionID": "fastq-analysis",
      "actionID": "fastqc",
      "expectedResult": { "status": "ok", "outputs": ["fastqc_report_html", "fastqc_report_zip"] },
      "timeoutSeconds": 600
    },
    {
      "id": "fastp",
      "kind": "action",
      "pageID": "fastq",
      "sectionID": "fastq-analysis",
      "actionID": "fastp",
      "timeoutSeconds": 600
    },
    {
      "id": "extract-region-mt",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "extract-inputs",
      "actionID": "region-mt",
      "inputs": {
        "fieldValues": {
          "ref_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz"
        },
        "checkedOptions": { "extract_formats": ["fasta", "bam", "vcf"] }
      },
      "expectedResult": { "status": "ok", "outputs": ["mt_bam", "mt_vcf", "mt_fasta"] },
      "timeoutSeconds": 900
    },
    {
      "id": "extract-region-y",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "extract-inputs",
      "actionID": "region-y",
      "inputs": {
        "fieldValues": {
          "ref_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz"
        },
        "checkedOptions": { "extract_formats": ["bam", "vcf"] }
      },
      "expectedResult": { "status": "ok", "outputs": ["y_bam", "y_vcf"] },
      "timeoutSeconds": 900
    },
    {
      "id": "extract-region-ymt",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "extract-inputs",
      "actionID": "region-ymt",
      "inputs": {
        "fieldValues": {
          "ref_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz"
        },
        "checkedOptions": { "extract_formats": ["bam"] }
      },
      "expectedResult": { "status": "ok", "outputs": ["y_mt_bam"] },
      "timeoutSeconds": 900
    },
    {
      "id": "extract-region-autox",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "extract-inputs",
      "actionID": "region-autox",
      "inputs": {
        "fieldValues": {
          "ref_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz"
        },
        "checkedOptions": { "extract_formats": ["bam"] }
      },
      "expectedResult": { "status": "ok", "outputs": ["autox_bam"] },
      "timeoutSeconds": 900
    },
    {
      "id": "extract-bam-subset",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "extract-more",
      "actionID": "bam-subset",
      "timeoutSeconds": 600
    },
    {
      "id": "extract-unmapped",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "extract-more",
      "actionID": "unmapped",
      "timeoutSeconds": 600
    },
    {
      "id": "extract-custom-region",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "extract-more",
      "actionID": "custom",
      "timeoutSeconds": 600
    },
    {
      "id": "microarray-from-vcf",
      "kind": "action",
      "pageID": "microarray",
      "sectionID": "microarray-formats",
      "actionID": "microarray-generate",
      "inputs": {
        "fieldValues": {
          "bam_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/HG00096.hg19-mini.vcf.gz",
          "ref_path": "{{usersWorkspace}}/reference"
        }
      },
      "timeoutSeconds": 1800
    },
    {
      "id": "vcf-call",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "variant-calling",
      "actionID": "vcf-call",
      "inputs": {
        "fieldValues": {
          "ref_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz"
        },
        "checkedOptions": { "vcf_call_types": ["snp", "indel"], "vcf_merge": ["--merge"] }
      },
      "expectedResult": { "status": "ok", "outputs": ["merged_variants"] },
      "timeoutSeconds": 1800
    },
    {
      "id": "vcf-call-sv-cnv",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "variant-calling",
      "actionID": "vcf-call",
      "inputs": {
        "fieldValues": {
          "ref_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz"
        },
        "checkedOptions": { "vcf_call_types": ["sv", "cnv"] }
      },
      "timeoutSeconds": 1800
    },
    {
      "id": "vcf-freebayes",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "variant-calling",
      "actionID": "vcf-freebayes",
      "inputs": {
        "fieldValues": {
          "ref_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz"
        }
      },
      "timeoutSeconds": 900
    },
    {
      "id": "vcf-gatk",
      "kind": "action",
      "pageID": "extract",
      "sectionID": "variant-calling",
      "actionID": "vcf-gatk",
      "inputs": {
        "fieldValues": {
          "ref_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/hg19-mini.fa.gz"
        }
      },
      "timeoutSeconds": 1200
    },
    {
      "id": "vcf-filter",
      "kind": "action",
      "pageID": "vcf",
      "sectionID": "vcf-annotation",
      "actionID": "vcf-filter",
      "timeoutSeconds": 300
    },
    {
      "id": "vcf-filter-gap-aware",
      "kind": "action",
      "pageID": "vcf",
      "sectionID": "vcf-annotation",
      "actionID": "vcf-filter-gap-aware",
      "inputs": {
        "fieldValues": {
          "ref_path": "{{usersWorkspace}}/reference",
          "vcf_exclude_gaps": "true"
        }
      },
      "timeoutSeconds": 300
    },
    {
      "id": "vcf-qc",
      "kind": "action",
      "pageID": "vcf",
      "sectionID": "vcf-info-commands",
      "actionID": "vcf-qc",
      "timeoutSeconds": 300
    },
    {
      "id": "vcf-trio",
      "kind": "action",
      "pageID": "annotate",
      "sectionID": "trio-analysis",
      "actionID": "vcf-trio",
      "timeoutSeconds": 600
    },
    {
      "id": "haplogrep-from-vcf",
      "kind": "action",
      "pageID": "ancestry",
      "sectionID": "haplogroup-analysis",
      "actionID": "run-haplogrep",
      "inputs": {
        "fieldValues": {
          "bam_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/HG00096.hg19-mini.vcf.gz"
        }
      },
      "timeoutSeconds": 900
    },
    {
      "id": "bam-unindex",
      "kind": "action",
      "pageID": "info-bam",
      "sectionID": "bam-commands",
      "actionID": "bam-unindex",
      "inputs": {
        "fieldValues": {
          "bam_path": "{{usersWorkspace}}/mygenomes/wgsextract-benchmark-hg19-mini/HG00096.hg19-mini.bam"
        }
      },
      "timeoutSeconds": 300
    }
  ]
}
