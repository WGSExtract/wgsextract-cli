#!/usr/bin/env python3
"""Code-only Clair3 build: explicit MPS on the CPU streaming pipeline."""

import json
import runpy
import sys
from pathlib import Path


def main() -> None:
    root = Path(__file__).resolve().parents[1] / "share" / "wgse-clair3"
    if sys.argv[1:] == ["--wgse-device-check"]:
        import torch

        print(
            json.dumps(
                {
                    "package": "wgse-clair3",
                    "version": "0.1.0",
                    "clair3_version": "2.0.5",
                    "streaming_mps": 1,
                    "mps_available": torch.backends.mps.is_available(),
                }
            )
        )
        return
    sys.path.insert(0, str(root))
    # All worker interpreters must use this package's dependency environment.
    sys.argv += [f"--python={sys.executable}"]
    runpy.run_path(str(root / "run_clair3.py"), run_name="__main__")


if __name__ == "__main__":
    main()
