diff --git b/deepvariant/native/ploidy.h b/deepvariant/native/ploidy.h
new file mode 100644
index 00000000..2e3025ad
--- /dev/null
+++ b/deepvariant/native/ploidy.h
@@ -0,0 +1,99 @@
+#pragma once
+
+#include <algorithm>
+#include <cstdint>
+#include <cstdlib>
+#include <map>
+#include <set>
+#include <sstream>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "htslib/hts.h"
+#include "htslib/kstring.h"
+
+namespace deepvariant {
+
+// Google 1.10 retains diploid GT/PL encoding, but removes heterozygous mass.
+inline void CorrectNonautosomeProbabilities(std::vector<double>* probabilities,
+                                            int n_alleles) {
+  if (probabilities->size() != n_alleles * (n_alleles + 1) / 2) {
+    throw std::invalid_argument("Probabilities do not match allele count");
+  }
+  size_t index = 0;
+  double sum = 0;
+  for (int h1 = 0; h1 < n_alleles; ++h1) {
+    for (int h2 = 0; h2 <= h1; ++h2, ++index) {
+      if (h1 != h2) (*probabilities)[index] = 0;
+      sum += (*probabilities)[index];
+    }
+  }
+  if (sum == 0) sum = 1;
+  for (double& p : *probabilities) p /= sum;
+}
+
+class HaploidPolicy {
+ public:
+  HaploidPolicy() = default;
+  HaploidPolicy(std::string contigs, const std::string& bed) {
+    std::replace(contigs.begin(), contigs.end(), ',', ' ');
+    std::istringstream names(contigs);
+    std::string name;
+    while (names >> name) contigs_.insert(name);
+    if (bed.empty()) return;
+    htsFile* file = hts_open(bed.c_str(), "r");
+    if (!file) throw std::invalid_argument("Cannot open PAR BED: " + bed);
+    kstring_t line = {0, 0, nullptr};
+    int status;
+    bool invalid = false;
+    while ((status = hts_getline(file, '\n', &line)) >= 0) {
+      std::string text(line.s, line.l);
+      if (text.empty() || text[0] == '#' || text.rfind("track ", 0) == 0 ||
+          text.rfind("browser ", 0) == 0) continue;
+      std::istringstream row(text);
+      int64_t start, end;
+      if (!(row >> name >> start >> end) || start < 0 || end <= start) {
+        invalid = true;
+        break;
+      }
+      par_[name].push_back({start, end});
+    }
+    free(line.s);
+    hts_close(file);
+    if (invalid || status < -1) {
+      throw std::invalid_argument("Invalid PAR BED: " + bed);
+    }
+    for (auto& item : par_) {
+      auto& intervals = item.second;
+      std::sort(intervals.begin(), intervals.end());
+      std::vector<std::pair<int64_t, int64_t>> merged;
+      for (const auto& interval : intervals) {
+        if (!merged.empty() && interval.first <= merged.back().second) {
+          merged.back().second = std::max(merged.back().second, interval.second);
+        } else {
+          merged.push_back(interval);
+        }
+      }
+      intervals = std::move(merged);
+    }
+  }
+
+  bool IsHaploid(const std::string& chrom, int64_t start, int64_t end) const {
+    if (!contigs_.count(chrom)) return false;
+    const auto found = par_.find(chrom);
+    if (found == par_.end()) return true;
+    const auto& intervals = found->second;
+    auto next = std::lower_bound(
+        intervals.begin(), intervals.end(), start,
+        [](const auto& interval, int64_t pos) { return interval.second <= pos; });
+    return next == intervals.end() || next->first >= end;
+  }
+
+ private:
+  std::set<std::string> contigs_;
+  std::map<std::string, std::vector<std::pair<int64_t, int64_t>>> par_;
+};
+
+}  // namespace deepvariant
diff --git b/deepvariant/native/ploidy_test.cc b/deepvariant/native/ploidy_test.cc
new file mode 100644
index 00000000..f4c13104
--- /dev/null
+++ b/deepvariant/native/ploidy_test.cc
@@ -0,0 +1,73 @@
+#include "deepvariant/native/gvcf_emit.h"
+#include "deepvariant/native/ploidy.h"
+
+#include <cmath>
+#include <cstdio>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+void Require(bool condition, const char* message) {
+  if (!condition) throw std::runtime_error(message);
+}
+}
+
+int main(int argc, char** argv) {
+  Require(argc == 2, "Supply the test BED path");
+  {
+    std::ofstream bed(argv[1]);
+    bed << "chrX\t10\t20\nchrX\t18\t25\n";
+  }
+  const deepvariant::HaploidPolicy policy("chrX, chrY chrM", argv[1]);
+  Require(policy.IsHaploid("chrX", 9, 10), "#1103: base before PAR");
+  Require(!policy.IsHaploid("chrX", 10, 11), "#1103: first PAR base");
+  Require(!policy.IsHaploid("chrX", 24, 25), "#1103: last PAR base");
+  Require(policy.IsHaploid("chrX", 25, 26), "#1103: base after PAR");
+  Require(!policy.IsHaploid("chrX", 9, 11), "#1103: indel overlaps PAR");
+  Require(!policy.IsHaploid("chr1", 0, 1), "#1103: autosome stays diploid");
+  Require(policy.IsHaploid("chrM", 0, 1), "#1103: mitochondrial contig");
+  std::vector<double> probabilities{0.1, 0.8, 0.1};
+  deepvariant::CorrectNonautosomeProbabilities(&probabilities, 2);
+  Require(probabilities == std::vector<double>({0.5, 0, 0.5}),
+          "#1103: het probability must be removed before calling");
+  probabilities = {0.1, 0.2, 0.1, 0.2, 0.3, 0.1};
+  deepvariant::CorrectNonautosomeProbabilities(&probabilities, 3);
+  Require(probabilities[1] == 0 && probabilities[3] == 0 &&
+          probabilities[4] == 0 && std::abs(probabilities[5] - 1.0 / 3) < 1e-12,
+          "#1103: all multiallelic heterozygotes must be removed");
+  probabilities = {0, 1, 0};
+  deepvariant::CorrectNonautosomeProbabilities(&probabilities, 2);
+  Require(probabilities == std::vector<double>({0, 0, 0}),
+          "#1103: Google zero-sum fallback is not uniform");
+
+  std::vector<learning::genomics::deepvariant::AlleleCountSummary> counts;
+  for (int pos = 8; pos < 27; ++pos) {
+    auto& count = counts.emplace_back();
+    count.set_reference_name("chrX");
+    count.set_position(pos);
+    count.set_ref_base("A");
+    count.set_ref_supporting_read_count(0);
+    count.set_total_read_count(0);
+  }
+  const auto rows = deepvariant::MakeGvcfRows(
+      counts, "test", 0.001, 5, 50, true, policy);
+  Require(rows.size() == 3, "#1103: zero-depth blocks must split at PAR edges");
+  Require(rows[0].start() == 8 && rows[0].end() == 10 &&
+          rows[1].start() == 10 && rows[1].end() == 25 &&
+          rows[2].start() == 25 && rows[2].end() == 27,
+          "#1103: gVCF partition coverage must have no gaps or overlaps");
+  const auto& haploid = rows[0].calls(0);
+  const auto& diploid = rows[1].calls(0);
+  Require(std::abs(haploid.genotype_likelihood(0) + std::log10(2.0)) < 1e-12 &&
+          haploid.genotype_likelihood(1) < -997 &&
+          std::abs(diploid.genotype_likelihood(0) + std::log10(3.0)) < 1e-12,
+          "#1103: haploid reference confidence must match Google 1.10");
+  Require(haploid.info().at("MIN_DP").values(0).int_value() == 0 &&
+          haploid.info().at("GQ").values(0).int_value() == 3 &&
+          diploid.info().at("GQ").values(0).int_value() == 1,
+          "#1103: retain depth and compute haploid GQ before binning");
+  std::remove(argv[1]);
+  std::cout << "haploid/PAR likelihood and gVCF regressions passed\n";
+}
