From 287a1f8f66dd32dd91f1a8a4c4e65d42c26d3cb3 Mon Sep 17 00:00:00 2001
From: WGS Extract AI <223556219+Copilot@users.noreply.github.com>
Date: Wed, 11 Nov 2026 12:43:33 -0800
Subject: [PATCH 2/5] Build from one static dependency prefix (wgsextract #647)

WGSE_DEPS_PREFIX takes static htslib (libdeflate, liblzma), abseil,
protobuf, re2 and Boost headers from one prefix instead of Homebrew, for
a self-contained binary. BUILD_TESTING=OFF skips GoogleTest and the
native tests. DV_VERSION and DV_SOURCE_ID set what --version prints.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 CMakeLists.txt                    |   9 ++-
 cmake/deps.cmake                  | 103 ++++++++++++++++++++----------
 deepvariant/native/CMakeLists.txt |  20 ++++--
 3 files changed, 89 insertions(+), 43 deletions(-)

diff --git a/CMakeLists.txt b/CMakeLists.txt
index e8aaa20..3c51212 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -57,6 +57,7 @@ list(PREPEND CMAKE_MODULE_PATH "${CMAKE_SOURCE_DIR}/cmake")
 # ---------------------------------------------------------------------------
 # External dependencies (order matters: protos before nucleus)
 # ---------------------------------------------------------------------------
+option(BUILD_TESTING "Build the native tests (fetches GoogleTest)" ON)
 include(deps)    # FetchContent / find_package for htslib, abseil, protobuf, ssw
 include(protos)  # compile DeepVariant + nucleus + TF-example protos
 
@@ -71,6 +72,8 @@ add_subdirectory(deepvariant/native)   # runtime binary (Phase 2+)
 # ---------------------------------------------------------------------------
 # Tests (Phase 1 gate: ctest -V must pass)
 # ---------------------------------------------------------------------------
-enable_testing()
-include(CTest)
-add_subdirectory(tests/native)  # thin wrappers around upstream C++ test code
+if(BUILD_TESTING)
+  enable_testing()
+  include(CTest)
+  add_subdirectory(tests/native)  # thin wrappers around upstream C++ test code
+endif()
diff --git a/cmake/deps.cmake b/cmake/deps.cmake
index 0fa86cb..f9104c1 100644
--- a/cmake/deps.cmake
+++ b/cmake/deps.cmake
@@ -15,6 +15,38 @@ include(FetchContent)
 set(FETCHCONTENT_QUIET OFF)
 set(FETCHCONTENT_UPDATES_DISCONNECTED ON)
 
+# ---------------------------------------------------------------------------
+# WGSE_DEPS_PREFIX: static htslib, abseil, protobuf, re2 and Boost headers
+# installed into one prefix (wgsextract-cli native/deepvariant superbuild),
+# for a self-contained binary. Otherwise the Homebrew packages below.
+# ---------------------------------------------------------------------------
+if(WGSE_DEPS_PREFIX)
+  set(HTSLIB_PREFIX "${WGSE_DEPS_PREFIX}")
+  set(ABSL_PREFIX "${WGSE_DEPS_PREFIX}")
+  set(PROTOBUF_PREFIX "${WGSE_DEPS_PREFIX}")
+  set(RE2_PREFIX "${WGSE_DEPS_PREFIX}")
+  list(PREPEND CMAKE_PREFIX_PATH "${WGSE_DEPS_PREFIX}")
+  find_package(absl REQUIRED CONFIG NO_DEFAULT_PATH PATHS "${WGSE_DEPS_PREFIX}")
+  find_package(protobuf REQUIRED CONFIG NO_DEFAULT_PATH PATHS "${WGSE_DEPS_PREFIX}")
+  find_program(PROTOC protoc NO_DEFAULT_PATH PATHS "${WGSE_DEPS_PREFIX}/bin" REQUIRED)
+  foreach(lib hts deflate lzma re2)
+    find_library(WGSE_${lib}_LIB NAMES lib${lib}.a NO_DEFAULT_PATH
+                 PATHS "${WGSE_DEPS_PREFIX}/lib" REQUIRED)
+  endforeach()
+  add_library(htslib::htslib STATIC IMPORTED)
+  set_target_properties(htslib::htslib PROPERTIES
+    IMPORTED_LOCATION "${WGSE_hts_LIB}"
+    INTERFACE_INCLUDE_DIRECTORIES "${WGSE_DEPS_PREFIX}/include")
+  target_link_libraries(htslib::htslib INTERFACE
+    "${WGSE_deflate_LIB}" "${WGSE_lzma_LIB}" z bz2 curl "-framework CoreFoundation")
+  add_library(re2::re2 STATIC IMPORTED)
+  set_target_properties(re2::re2 PROPERTIES
+    IMPORTED_LOCATION "${WGSE_re2_LIB}"
+    INTERFACE_INCLUDE_DIRECTORIES "${WGSE_DEPS_PREFIX}/include")
+  target_link_libraries(re2::re2 INTERFACE absl::strings absl::synchronization)
+  set(BOOST_INCLUDE_DIR "${WGSE_DEPS_PREFIX}/include" CACHE INTERNAL "")
+  message(STATUS "dependencies: ${WGSE_DEPS_PREFIX}")
+else()
 # ---------------------------------------------------------------------------
 # htslib 1.18 — Homebrew (avoids autoconf complexity on macOS)
 # ---------------------------------------------------------------------------
@@ -75,6 +107,41 @@ message(STATUS "protobuf: ${PROTOBUF_PREFIX}")
 find_program(PROTOC protoc HINTS "${PROTOBUF_PREFIX}/bin" REQUIRED)
 message(STATUS "protoc: ${PROTOC}")
 
+# ---------------------------------------------------------------------------
+# re2 — Homebrew
+# ---------------------------------------------------------------------------
+execute_process(
+  COMMAND ${BREW_EXECUTABLE} --prefix re2
+  OUTPUT_VARIABLE RE2_PREFIX
+  OUTPUT_STRIP_TRAILING_WHITESPACE
+)
+if(NOT RE2_PREFIX)
+  message(FATAL_ERROR "re2 not found — run: brew install re2")
+endif()
+add_library(re2::re2 STATIC IMPORTED)
+find_library(RE2_LIB NAMES libre2.a re2 PATHS "${RE2_PREFIX}/lib" REQUIRED)
+set_target_properties(re2::re2 PROPERTIES
+  IMPORTED_LOCATION "${RE2_LIB}"
+  INTERFACE_INCLUDE_DIRECTORIES "${RE2_PREFIX}/include"
+)
+message(STATUS "re2: ${RE2_LIB}")
+
+# ---------------------------------------------------------------------------
+# Boost — Homebrew (for debruijn_graph.h in realigner/)
+# ---------------------------------------------------------------------------
+execute_process(
+  COMMAND ${BREW_EXECUTABLE} --prefix boost
+  OUTPUT_VARIABLE BOOST_PREFIX
+  OUTPUT_STRIP_TRAILING_WHITESPACE
+)
+if(NOT BOOST_PREFIX)
+  message(FATAL_ERROR "boost not found — run: brew install boost")
+endif()
+message(STATUS "boost: ${BOOST_PREFIX}")
+set(BOOST_INCLUDE_DIR "${BOOST_PREFIX}/include" CACHE INTERNAL "")
+
+endif()
+
 # ---------------------------------------------------------------------------
 # libssw 1.2.5 — Smith-Waterman aligner (realigner/)
 # ---------------------------------------------------------------------------
@@ -117,39 +184,7 @@ target_include_directories(ssw PUBLIC "${libssw_SOURCE_DIR}")
 # arm64 does not have SSE2; the fallback scalar path is used automatically.
 set(DV_LIBSSW_DIR "${libssw_SOURCE_DIR}" CACHE INTERNAL "libssw source root")
 
-# ---------------------------------------------------------------------------
-# re2 — Homebrew
-# ---------------------------------------------------------------------------
-execute_process(
-  COMMAND ${BREW_EXECUTABLE} --prefix re2
-  OUTPUT_VARIABLE RE2_PREFIX
-  OUTPUT_STRIP_TRAILING_WHITESPACE
-)
-if(NOT RE2_PREFIX)
-  message(FATAL_ERROR "re2 not found — run: brew install re2")
-endif()
-add_library(re2::re2 STATIC IMPORTED)
-find_library(RE2_LIB NAMES libre2.a re2 PATHS "${RE2_PREFIX}/lib" REQUIRED)
-set_target_properties(re2::re2 PROPERTIES
-  IMPORTED_LOCATION "${RE2_LIB}"
-  INTERFACE_INCLUDE_DIRECTORIES "${RE2_PREFIX}/include"
-)
-message(STATUS "re2: ${RE2_LIB}")
-
-# ---------------------------------------------------------------------------
-# Boost — Homebrew (for debruijn_graph.h in realigner/)
-# ---------------------------------------------------------------------------
-execute_process(
-  COMMAND ${BREW_EXECUTABLE} --prefix boost
-  OUTPUT_VARIABLE BOOST_PREFIX
-  OUTPUT_STRIP_TRAILING_WHITESPACE
-)
-if(NOT BOOST_PREFIX)
-  message(FATAL_ERROR "boost not found — run: brew install boost")
-endif()
-message(STATUS "boost: ${BOOST_PREFIX}")
-set(BOOST_INCLUDE_DIR "${BOOST_PREFIX}/include" CACHE INTERNAL "")
-
+if(BUILD_TESTING)
 # ---------------------------------------------------------------------------
 # GoogleTest — FetchContent (no standalone Homebrew package)
 # ---------------------------------------------------------------------------
@@ -162,6 +197,8 @@ set(INSTALL_GTEST OFF)
 FetchContent_MakeAvailable(googletest)
 set(GTEST_PREFIX "${googletest_SOURCE_DIR}" CACHE INTERNAL "")
 
+endif()
+
 # ---------------------------------------------------------------------------
 # zlib — guaranteed present on macOS (from Xcode SDK)
 # ---------------------------------------------------------------------------
diff --git a/deepvariant/native/CMakeLists.txt b/deepvariant/native/CMakeLists.txt
index df7f02a..4172407 100644
--- a/deepvariant/native/CMakeLists.txt
+++ b/deepvariant/native/CMakeLists.txt
@@ -585,18 +585,24 @@ target_compile_options(deepvariant PRIVATE ${ME_COMPILE_OPTS})
 #                          on every build via add_custom_target below; if
 #                          the SHA drifts, cli.cc gets recompiled.
 #   DV_BUILD_DATE        — ISO 8601 date of the build (UTC).
-execute_process(
-  COMMAND git rev-parse --short HEAD
-  WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
-  OUTPUT_VARIABLE DV_GIT_SHA
-  OUTPUT_STRIP_TRAILING_WHITESPACE
-  ERROR_QUIET)
+set(DV_VERSION "v2-applesilicon" CACHE STRING "Version tag printed by --version")
+set(DV_SOURCE_ID "" CACHE STRING "Source revision printed by --version (default: git HEAD)")
+if(DV_SOURCE_ID)
+  set(DV_GIT_SHA "${DV_SOURCE_ID}")
+else()
+  execute_process(
+    COMMAND git rev-parse --short HEAD
+    WORKING_DIRECTORY "${CMAKE_SOURCE_DIR}"
+    OUTPUT_VARIABLE DV_GIT_SHA
+    OUTPUT_STRIP_TRAILING_WHITESPACE
+    ERROR_QUIET)
+endif()
 if(NOT DV_GIT_SHA)
   set(DV_GIT_SHA "unknown")
 endif()
 string(TIMESTAMP DV_BUILD_DATE "%Y-%m-%d" UTC)
 target_compile_definitions(deepvariant PRIVATE
-  DV_VERSION="v2-applesilicon"
+  DV_VERSION="${DV_VERSION}"
   DV_UPSTREAM_VERSION="1.10.0"
   DV_GIT_SHA="${DV_GIT_SHA}"
   DV_BUILD_DATE="${DV_BUILD_DATE}"
