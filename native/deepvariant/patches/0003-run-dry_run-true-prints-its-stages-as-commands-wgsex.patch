+int RunStage(int (*stage)(int, char**), const std::string& prog,
+             const std::vector<std::string>& args) {
+  auto argv = MakeArgv(prog, args);
+  return stage(static_cast<int>(argv.size()) - 1, argv.data());
+}
+
+std::string ExecutablePath() {
+  uint32_t size = 0;
+  _NSGetExecutablePath(nullptr, &size);
+  std::string path(size, '\0');
+  if (_NSGetExecutablePath(path.data(), &size) != 0) return "deepvariant";
+  path.resize(std::strlen(path.c_str()));
+  std::error_code ec;
+  auto canonical = std::filesystem::weakly_canonical(path, ec);
+  return ec ? path : canonical.string();
+}
+
+std::string ShellQuote(const std::string& s) {
+  if (!s.empty() && s.find_first_not_of(
+                        "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"
+                        "0123456789_@%+=:,./-") == std::string::npos) {
+    return s;
+  }
+  std::string out = "'";
+  for (char c : s) out += c == '\'' ? std::string("'\\''") : std::string(1, c);
+  return out + "'";
+}
+
+void PrintStageCommand(const std::string& self, const std::string& stage,
+                       const std::vector<std::string>& args) {
+  std::string line = ShellQuote(self) + " " + stage;
+  for (const auto& a : args) line += " " + ShellQuote(a);
+  std::printf("\n***** Running the command:*****\n%s\n\n", line.c_str());
+}
