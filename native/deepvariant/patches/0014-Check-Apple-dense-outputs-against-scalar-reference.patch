diff --git a/deepvariant/native/small_model_dense.h b/deepvariant/native/small_model_dense.h
new file mode 100644
index 00000000..47b53327
--- /dev/null
+++ b/deepvariant/native/small_model_dense.h
@@ -0,0 +1,9 @@
+#pragma once
+
+namespace deepvariant {
+
+// Internal kernel shared by inference and the bitwise scalar-reference check.
+void DenseFp32(const float* x, int in_dim, const float* W, const float* b,
+               int out_dim, float* y);
+
+}  // namespace deepvariant
diff --git a/deepvariant/native/small_model_dense_test.mm b/deepvariant/native/small_model_dense_test.mm
new file mode 100644
index 00000000..8f88fecc
--- /dev/null
+++ b/deepvariant/native/small_model_dense_test.mm
@@ -0,0 +1,99 @@
+#include "deepvariant/native/small_model_dense.h"
+
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <vector>
+
+namespace {
+
+// Exact pre-0012 loop: input order, FP32 accumulator and bias placement.
+void ScalarDenseFp32(const float* x, int in_dim,
+                     const float* W, const float* b,
+                     int out_dim, float* y) {
+  for (int o = 0; o < out_dim; ++o) {
+    float acc = 0.0f;
+    for (int i = 0; i < in_dim; ++i) {
+      acc += x[i] * W[i * out_dim + o];
+    }
+    y[o] = acc + b[o];
+  }
+}
+
+uint32_t Bits(float value) {
+  uint32_t bits;
+  static_assert(sizeof(bits) == sizeof(value));
+  std::memcpy(&bits, &value, sizeof(bits));
+  return bits;
+}
+
+float MixedValue(uint32_t* state) {
+  *state = *state * 1664525u + 1013904223u;
+  // Finite FP32 values with varied mantissas, signs and exponents [-32, 32].
+  const uint32_t bits = (*state & 0x807fffffu) |
+      ((95u + ((*state >> 23) % 65u)) << 23);
+  float value;
+  std::memcpy(&value, &bits, sizeof(value));
+  return value;
+}
+
+bool Check(int in_dim, int fixture) {
+  constexpr int out_dim = 750;
+  const float denorm = std::numeric_limits<float>::denorm_min();
+  const float edges[] = {0.0f, -0.0f, denorm, -denorm,
+                        std::numeric_limits<float>::min(),
+                        -std::numeric_limits<float>::min(),
+                        0x1p40f, -0x1p40f, 1.0f, -1.0f,
+                        0x1.000002p0f, 0x1.fffffep-1f};
+  std::vector<float> x(in_dim), W(in_dim * out_dim), b(out_dim);
+  std::vector<float> expected(out_dim), actual(out_dim, -123.0f);
+  uint32_t state = 1116u + in_dim * 17u + fixture;
+  for (int i = 0; i < in_dim; ++i) {
+    x[i] = MixedValue(&state);
+    if (fixture == 0) x[i] = i % 2 ? -0.0f : 0.0f;
+    if (fixture == 1) x[i] = (i % 3 + 1) * denorm;
+    if (fixture == 2) x[i] = edges[i % 12];
+    if (fixture == 3) x[i] = 1.0f;
+    if (fixture == 4) x[i] = i % 2 ? 0x1.000002p0f : -1.0f;
+    for (int o = 0; o < out_dim; ++o) {
+      float value = MixedValue(&state);
+      if (fixture == 1) value = (i + o) % 3 == 0 ? -1.0f : 1.0f;
+      if (fixture == 2) value = edges[(i * 7 + o) % 12];
+      // Rounding-sensitive cancellation: (large + tiny) - large.
+      if (fixture == 3) {
+        const float terms[] = {0x1p24f, 1.0f, -0x1p24f, -0.5f};
+        value = terms[(i + o) % 4];
+      }
+      if (fixture == 4) value = i % 2 ? 0x1.fffffep-1f : 1.0f;
+      W[i * out_dim + o] = value;
+    }
+  }
+  for (int o = 0; o < out_dim; ++o) {
+    b[o] = fixture == 1 ? (o % 2 ? -denorm : denorm) : edges[o % 12];
+  }
+  ScalarDenseFp32(x.data(), in_dim, W.data(), b.data(), out_dim, expected.data());
+  deepvariant::DenseFp32(x.data(), in_dim, W.data(), b.data(), out_dim, actual.data());
+  for (int o = 0; o < out_dim; ++o) {
+    if (!std::isfinite(expected[o]) || Bits(actual[o]) != Bits(expected[o])) {
+      std::fprintf(stderr,
+          "DenseFp32 mismatch: %d->%d fixture=%d output=%d scalar=%08x production=%08x\n",
+          in_dim, out_dim, fixture, o, Bits(expected[o]), Bits(actual[o]));
+      return false;
+    }
+  }
+  return true;
+}
+
+}  // namespace
+
+int main() {
+  for (int in_dim : {70, 94, 106, 750}) {
+    for (int fixture = 0; fixture < 6; ++fixture) {
+      if (!Check(in_dim, fixture)) return 1;
+    }
+  }
+  std::puts("DenseFp32 scalar-reference check passed: 4 shapes, 6 fixtures, 18000 bitwise outputs");
+  return 0;
+}
