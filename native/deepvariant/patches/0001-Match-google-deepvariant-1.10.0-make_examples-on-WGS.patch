-  return absl::StrCat(prefix, "-", absl::Dec(task_id, absl::kZeroPad5),
-                       "-of-", absl::Dec(n, absl::kZeroPad5));
+  if (!ParseShardSpec(spec, &prefix, &n, &suffix)) return spec;
+  return ShardPath(prefix, task_id, n, suffix);
+}
+
+std::vector<std::string> ExpandShards(const std::string& spec) {
+  std::string prefix, suffix;
+  int n = 0;
+  if (!ParseShardSpec(spec, &prefix, &n, &suffix)) return {spec};
+  std::vector<std::string> paths;
+  paths.reserve(n);
+  for (int i = 0; i < n; ++i) paths.push_back(ShardPath(prefix, i, n, suffix));
+  return paths;
 }

