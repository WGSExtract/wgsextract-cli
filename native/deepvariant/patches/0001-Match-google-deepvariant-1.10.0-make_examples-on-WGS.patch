+// Splits "prefix@N[suffix]" into its parts; false for a plain path.
+bool ParseShardSpec(const std::string& spec, std::string* prefix, int* n,
+                    std::string* suffix) {
+  const auto at = spec.find('@');
+  if (at == std::string::npos) return false;
+  size_t end = at + 1;
+  while (end < spec.size() && spec[end] >= '0' && spec[end] <= '9') ++end;
+  if (!absl::SimpleAtoi(spec.substr(at + 1, end - at - 1), n) || *n <= 0)
+    return false;
+  *prefix = spec.substr(0, at);
+  *suffix = spec.substr(end);
+  return true;
+}
+
+std::string ShardPath(const std::string& prefix, int i, int n,
+                      const std::string& suffix) {
+  return absl::StrCat(prefix, "-", absl::Dec(i, absl::kZeroPad5), "-of-",
+                      absl::Dec(n, absl::kZeroPad5), suffix);
 }
 }  // namespace

 std::string ShardName(const std::string& spec, int task_id) {
-  auto at = spec.find('@');
