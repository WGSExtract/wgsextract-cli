From b2b504e0d0a94cb520bc250785e623245d8fa826 Mon Sep 17 00:00:00 2001
From: WGS Extract AI <223556219+Copilot@users.noreply.github.com>
Date: Wed, 11 Nov 2026 13:49:40 -0800
Subject: [PATCH 4/5] Read --reads from URLs and accept .csi BAM indexes
 (wgsextract #647)

htslib reads http(s) and ftp URLs, and their indexes, itself: skip the
local existence and index checks for them. A BAM's .csi index is as good
as a .bai.

Co-authored-by: Copilot <223556219+Copilot@users.noreply.github.com>
---
 deepvariant/native/cli.cc | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/deepvariant/native/cli.cc b/deepvariant/native/cli.cc
index 69e0a67..5ff41f3 100644
--- a/deepvariant/native/cli.cc
+++ b/deepvariant/native/cli.cc
@@ -576,9 +576,14 @@ static void MaybeAutoDiscoverTrioOrSomaticSmallModel(
 // Empty path is treated as "user didn't set it"; existing required-flag
 // checks (LOG(ERROR) << "... required") handle that case separately, so this
 // helper just no-ops on empty input.
+// htslib reads http(s)/ftp/s3 URLs itself (and finds their index there).
+static bool IsUrl(const std::string& path) {
+  return path.find("://") != std::string::npos;
+}
+
 static bool EnsurePathExists(const std::string& path,
                               const std::string& flag_name) {
-  if (path.empty()) return true;
+  if (path.empty() || IsUrl(path)) return true;
   struct stat st{};
   if (::stat(path.c_str(), &st) == 0) return true;
   LOG(ERROR) << flag_name << "=" << path
@@ -609,11 +614,12 @@ static bool EnsureFastaIndexed(const std::string& fasta_path) {
 // confusing "no index" error from htslib.
 static bool EnsureBamIndexed(const std::string& bam_path,
                               const std::string& flag_name) {
-  if (bam_path.empty()) return true;
+  if (bam_path.empty() || IsUrl(bam_path)) return true;
   const auto exists = [](const std::string& p) {
     struct stat st{};
     return ::stat(p.c_str(), &st) == 0;
   };
+  if (exists(absl::StrCat(bam_path, ".csi"))) return true;
   const std::string ext = bam_path.size() >= 4
       ? bam_path.substr(bam_path.size() - 4) : "";
   if (ext == ".bam") {
