+std::string Attr(int n, const char* name) {
+  return absl::StrCat("layer_with_weights-", n, "/", name,
+                      "/.ATTRIBUTES/VARIABLE_VALUE");
+}
+
+Ort::OpAttr IntsAttr(const char* name, const std::vector<int64_t>& v) {
+  return Ort::OpAttr(name, v.data(), static_cast<int>(v.size()),
+                     OrtOpAttrType::ORT_OP_ATTR_INTS);
+}
+
+Ort::OpAttr IntAttr(const char* name, int64_t v) {
+  return Ort::OpAttr(name, &v, 1, OrtOpAttrType::ORT_OP_ATTR_INT);
+}
+
+// Builds the graph node by node. Initializers are copied into tensors the
+// graph owns, so the .dvw can be closed once the session exists.
+class GraphBuilder {
+ public:
+  explicit GraphBuilder(const DvwWeights& w) : w_(w) {}
+
+  Ort::Graph& graph() { return graph_; }
+
+  std::string Name(const char* prefix) {
+    return absl::StrCat(prefix, "_", ++counter_);
+  }
+
+  void AddNode(const std::string& op, const std::vector<std::string>& inputs,
+               const std::vector<std::string>& outputs,
+               std::vector<Ort::OpAttr> attrs = {}) {
+    Ort::Node node(op, "", Name(op.c_str()), inputs, outputs, attrs);
+    graph_.AddNode(node);
+  }
+
+  void AddTensor(const std::string& name, const std::vector<int64_t>& shape,
+                 const float* data) {
+    Ort::Value value = Ort::Value::CreateTensor<float>(
+        allocator_, shape.data(), shape.size());
+    size_t count = 1;
+    for (int64_t d : shape) count *= static_cast<size_t>(d);
+    std::memcpy(value.GetTensorMutableData<float>(), data,
+                count * sizeof(float));
+    graph_.AddInitializer(name, value, /*data_is_external=*/false);
+  }
+
+  // Conv (HWIO kernel, folded with its BatchNormalization) + ReLU.
+  std::string Cbr(const std::string& x, int conv, int bn, int stride = 1,
+                  bool same = true) {
+    const DvwTensor* k = Need(Attr(conv, "kernel"));
+    const DvwTensor* beta = Need(Attr(bn, "beta"));
+    const DvwTensor* mean = Need(Attr(bn, "moving_mean"));
+    const DvwTensor* var = Need(Attr(bn, "moving_variance"));
+    if (k->shape.size() != 4) throw std::runtime_error("conv kernel rank");
+    const int kh = k->shape[0], kw = k->shape[1], ci = k->shape[2],
+              co = k->shape[3];
+    std::vector<float> scale(co), bias(co);
+    for (int o = 0; o < co; ++o) {
+      scale[o] = 1.0f / std::sqrt(var->data[o] + kBNEpsilon);
+      bias[o] = beta->data[o] - mean->data[o] * scale[o];
+    }
+    std::vector<float> oihw(static_cast<size_t>(co) * ci * kh * kw);
+    for (int h = 0; h < kh; ++h)
+      for (int w = 0; w < kw; ++w)
+        for (int i = 0; i < ci; ++i)
+          for (int o = 0; o < co; ++o)
+            oihw[((static_cast<size_t>(o) * ci + i) * kh + h) * kw + w] =
+                k->data[((static_cast<size_t>(h) * kw + w) * ci + i) * co + o] *
+                scale[o];
+    const std::string wn = Name("w"), bn_name = Name("b"), y = Name("conv"),
+                      r = Name("relu");
+    AddTensor(wn, {co, ci, kh, kw}, oihw.data());
+    AddTensor(bn_name, {co}, bias.data());
+    // Keras "same" with stride 1 (the only "same" convs here): the extra
+    // padding of an even kernel goes after.
+    std::vector<int64_t> pads = {0, 0, 0, 0};
+    if (same) pads = {(kh - 1) / 2, (kw - 1) / 2, kh / 2, kw / 2};
+    std::vector<Ort::OpAttr> attrs;
+    attrs.push_back(IntsAttr("kernel_shape", {kh, kw}));
+    attrs.push_back(IntsAttr("strides", {stride, stride}));
+    attrs.push_back(IntsAttr("pads", pads));
+    AddNode("Conv", {x, wn, bn_name}, {y}, std::move(attrs));
+    AddNode("Relu", {y}, {r});
+    return r;
+  }
+
+  std::string MaxPool(const std::string& x) {
+    const std::string y = Name("maxpool");
+    std::vector<Ort::OpAttr> attrs;
+    attrs.push_back(IntsAttr("kernel_shape", {3, 3}));
+    attrs.push_back(IntsAttr("strides", {2, 2}));
+    AddNode("MaxPool", {x}, {y}, std::move(attrs));
+    return y;
+  }
+
+  // Keras AveragePooling2D(3, strides=1, padding="same"): padding excluded
+  // from the average.
+  std::string AvgPool(const std::string& x) {
+    const std::string y = Name("avgpool");
+    std::vector<Ort::OpAttr> attrs;
+    attrs.push_back(IntsAttr("kernel_shape", {3, 3}));
+    attrs.push_back(IntsAttr("strides", {1, 1}));
+    attrs.push_back(IntsAttr("pads", {1, 1, 1, 1}));
+    attrs.push_back(IntAttr("count_include_pad", 0));
+    AddNode("AveragePool", {x}, {y}, std::move(attrs));
+    return y;
+  }
+
+  std::string Concat(const std::vector<std::string>& xs) {
+    const std::string y = Name("concat");
+    std::vector<Ort::OpAttr> attrs;
+    attrs.push_back(IntAttr("axis", 1));
+    AddNode("Concat", xs, {y}, std::move(attrs));
+    return y;
+  }
+
+  const DvwTensor* Need(const std::string& name) {
+    const DvwTensor* t = w_.Get(name);
+    if (!t) throw std::runtime_error("missing weight " + name);
+    return t;
+  }
+
+ private:
+  const DvwWeights& w_;
+  Ort::Graph graph_;
+  Ort::AllocatorWithDefaultOptions allocator_;
+  int counter_ = 0;
+};
+
+// tf.keras.applications.InceptionV3 (include_top=False, pooling="avg") with
+// layer_with_weights indices as metal_inference.mm / inception_v3_mil.py.
+std::string Inception(GraphBuilder& g, std::string x) {
+  x = g.Cbr(x, 0, 1, 2, false);
+  x = g.Cbr(x, 2, 3, 1, false);
+  x = g.Cbr(x, 4, 5);
+  x = g.MaxPool(x);
+  x = g.Cbr(x, 6, 7, 1, false);
+  x = g.Cbr(x, 8, 9, 1, false);
+  x = g.MaxPool(x);
+  for (int b : {10, 24, 38}) {  // Mixed_5b, 5c, 5d
+    const std::string b1 = g.Cbr(x, b + 6, b + 10);
+    const std::string b5 = g.Cbr(g.Cbr(x, b + 2, b + 4), b + 7, b + 11);
+    const std::string b3 =
+        g.Cbr(g.Cbr(g.Cbr(x, b, b + 1), b + 3, b + 5), b + 8, b + 12);
+    const std::string bp = g.Cbr(g.AvgPool(x), b + 9, b + 13);
+    x = g.Concat({b1, b5, b3, bp});
+  }
+  {  // Mixed_6a
+    const std::string b3 = g.Cbr(x, 56, 58, 2, false);
+    const std::string bd =
+        g.Cbr(g.Cbr(g.Cbr(x, 52, 53), 54, 55), 57, 59, 2, false);
+    x = g.Concat({b3, bd, g.MaxPool(x)});
+  }
+  for (int b : {60, 80, 100, 120}) {  // Mixed_6b to 6e
+    const std::string b1 = g.Cbr(x, b + 12, b + 16);
+    const std::string b7a = g.Cbr(
+        g.Cbr(g.Cbr(x, b + 4, b + 6), b + 8, b + 10), b + 13, b + 17);
+    std::string b7b = x;
+    for (auto [c, n] : std::vector<std::pair<int, int>>{
+             {b, b + 1}, {b + 2, b + 3}, {b + 5, b + 7}, {b + 9, b + 11},
+             {b + 14, b + 18}}) {
+      b7b = g.Cbr(b7b, c, n);
+    }
+    const std::string bp = g.Cbr(g.AvgPool(x), b + 15, b + 19);
+    x = g.Concat({b1, b7a, b7b, bp});
+  }
+  {  // Mixed_7a
+    const std::string b3 = g.Cbr(g.Cbr(x, 144, 146), 148, 150, 2, false);
+    const std::string b7 = g.Cbr(
+        g.Cbr(g.Cbr(g.Cbr(x, 140, 141), 142, 143), 145, 147), 149, 151, 2,
+        false);
+    x = g.Concat({b3, b7, g.MaxPool(x)});
+  }
+  for (int b : {152, 170}) {  // Mixed_7b, 7c
+    const std::string b1 = g.Cbr(x, b + 10, b + 16);
+    const std::string b3a = g.Cbr(x, b + 2, b + 4);
+    const std::string b3a1 = g.Cbr(b3a, b + 6, b + 11);
+    const std::string b3a3 = g.Cbr(b3a, b + 7, b + 12);
+    const std::string b3b = g.Cbr(g.Cbr(x, b, b + 1), b + 3, b + 5);
+    const std::string b3b1 = g.Cbr(b3b, b + 8, b + 13);
+    const std::string b3b3 = g.Cbr(b3b, b + 9, b + 14);
+    const std::string bp = g.Cbr(g.AvgPool(x), b + 15, b + 17);
+    x = g.Concat({b1, b3a1, b3a3, b3b1, b3b3, bp});
+  }
+  return x;
+}
+
+Ort::ValueInfo TensorInfo(const std::string& name,
+                          ONNXTensorElementDataType type,
+                          const std::vector<int64_t>& dims) {
+  const std::vector<std::string> symbolic(dims.size(), "N");
+  Ort::TensorTypeAndShapeInfo shape(type, dims, &symbolic);
+  Ort::TypeInfo info = Ort::TypeInfo::CreateTensorInfo(shape.GetConst());
+  return Ort::ValueInfo(name, info.GetConst());
+}
+
+Ort::Env& Environment() {
+  // Fatal only: cuDNN's exhaustive algorithm search logs every convolution
+  // plan it can't use as an error. Real failures reach us as exceptions.
+  static Ort::Env env(ORT_LOGGING_LEVEL_FATAL, "wgse-deepvariant");
+  return env;
+}
+
+}  // namespace
+
+struct OnnxInception::Impl {
+  int h = 0, w = 0, c = 0;
+  bool cuda = false;
+  Ort::Session session{nullptr};
+  Ort::MemoryInfo cpu_memory{nullptr};
+};
+
+OnnxInception::OnnxInception() : impl_(std::make_unique<Impl>()) {}
+OnnxInception::~OnnxInception() = default;
+
+bool OnnxInception::UsesCuda() const { return impl_->cuda; }
+
+std::unique_ptr<OnnxInception> OnnxInception::Create(
+    const std::string& dvw_path, int height, int width, int channels,
+    Device device, int cpu_threads, int gpu_id) {
+  Environment();  // ONNX Runtime's logger, which the providers need.
+  auto weights = DvwWeights::Open(dvw_path);
+  if (!weights) {
+    LOG(ERROR) << "Cannot read the .dvw weights " << dvw_path;
+    return nullptr;
+  }
+  auto build_model = [&]() {
+    GraphBuilder g(*weights);
+    const float c128 = 128.0f;
+    g.AddTensor("c128", {1}, &c128);
+    g.AddNode("Cast", {"images"}, {"f"}, [] {
+      std::vector<Ort::OpAttr> a;
+      a.push_back(IntAttr("to", ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT));
+      return a;
+    }());
+    g.AddNode("Sub", {"f", "c128"}, {"centred"});
+    g.AddNode("Div", {"centred", "c128"}, {"scaled"});
+    g.AddNode("Transpose", {"scaled"}, {"nchw"}, [] {
+      std::vector<Ort::OpAttr> a;
+      a.push_back(IntsAttr("perm", {0, 3, 1, 2}));
+      return a;
+    }());
+    const std::string features = Inception(g, "nchw");
+    const DvwTensor* k = g.Need(Attr(188, "kernel"));
+    const DvwTensor* b = g.Need(Attr(188, "bias"));
+    if (k->shape.size() != 2 || k->shape[1] != 3 || b->n_elements != 3) {
+      throw std::runtime_error("classification layer isn't (2048, 3)");
+    }
+    g.AddTensor("fc_w", {k->shape[0], k->shape[1]}, k->data);
+    g.AddTensor("fc_b", {3}, b->data);
+    g.AddNode("GlobalAveragePool", {features}, {"pooled"});
+    g.AddNode("Flatten", {"pooled"}, {"flat"});
+    g.AddNode("Gemm", {"flat", "fc_w", "fc_b"}, {"logits"});
+    g.AddNode("Softmax", {"logits"}, {"probs"}, [] {
+      std::vector<Ort::OpAttr> a;
+      a.push_back(IntAttr("axis", 1));
+      return a;
+    }());
+    std::vector<Ort::ValueInfo> inputs, outputs;
+    inputs.push_back(TensorInfo("images", ONNX_TENSOR_ELEMENT_DATA_TYPE_UINT8,
+                                {-1, height, width, channels}));
+    outputs.push_back(
+        TensorInfo("probs", ONNX_TENSOR_ELEMENT_DATA_TYPE_FLOAT, {-1, 3}));
+    g.graph().SetInputs(inputs);
+    g.graph().SetOutputs(outputs);
+    Ort::Model model({{"", kOpset}});
+    model.AddGraph(g.graph());
+    return model;
+  };
+
+  auto out = std::unique_ptr<OnnxInception>(new OnnxInception());
+  out->impl_->h = height;
+  out->impl_->w = width;
+  out->impl_->c = channels;
+  out->impl_->cpu_memory =
+      Ort::MemoryInfo::CreateCpu(OrtArenaAllocator, OrtMemTypeDefault);
+
+  auto make_session = [&](bool cuda) {
+    Ort::SessionOptions options;
+    options.SetGraphOptimizationLevel(GraphOptimizationLevel::ORT_ENABLE_ALL);
+    if (cpu_threads > 0) options.SetIntraOpNumThreads(cpu_threads);
+    if (cuda) {
+      Ort::CUDAProviderOptions cuda_options;
+      cuda_options.Update({
+          {"device_id", std::to_string(gpu_id)},
+          {"use_tf32", "0"},
+          {"cudnn_conv_algo_search", "EXHAUSTIVE"},
+          {"do_copy_in_default_stream", "1"},
+      });
+      options.AppendExecutionProvider_CUDA_V2(*cuda_options);
+    }
+    Ort::Model model = build_model();
+    return Ort::Session(Environment(), model, options);
+  };
+
+  // One example through the session: CUDA libraries (cuDNN, cuBLAS) and
+  // the GPU's memory are only touched by a run.
+  auto probe = [&](Ort::Session& session) {
+    std::vector<uint8_t> image(static_cast<size_t>(height) * width * channels,
+                               128);
+    float probs[3];
+    const std::vector<int64_t> shape = {1, height, width, channels};
+    const std::vector<int64_t> out_shape = {1, 3};
+    Ort::Value input = Ort::Value::CreateTensor<uint8_t>(
+        out->impl_->cpu_memory, image.data(), image.size(), shape.data(),
+        shape.size());
+    Ort::Value output = Ort::Value::CreateTensor<float>(
+        out->impl_->cpu_memory, probs, 3, out_shape.data(), out_shape.size());
+    const char* in_names[] = {"images"};
+    const char* out_names[] = {"probs"};
+    session.Run(Ort::RunOptions{nullptr}, in_names, &input, 1, out_names,
+                &output, 1);
+  };
+
+  const auto providers = Ort::GetAvailableProviders();
+  const bool cuda_built =
+      std::find(providers.begin(), providers.end(), "CUDAExecutionProvider") !=
+      providers.end();
+  if (device == Device::kCuda && !cuda_built) {
+    LOG(ERROR) << "call_variants can't use CUDA: this ONNX Runtime is a "
+                  "CPU-only build.";
+    return nullptr;
+  }
+  // A CPU-only ONNX Runtime (the cpu package) runs on the CPU without a word.
+  const bool want_cuda = device != Device::kCpu && cuda_built;
+  if (want_cuda) {
+    try {
+      Ort::Session session = make_session(true);
+      probe(session);
+      out->impl_->session = std::move(session);
+      out->impl_->cuda = true;
+    } catch (const std::exception& e) {
+      if (device == Device::kCuda) {
+        LOG(ERROR) << "call_variants can't use CUDA: " << e.what();
+        return nullptr;
+      }
+      LOG(WARNING) << "CUDA isn't usable (" << e.what()
+                   << "); call_variants runs on the CPU.";
+    }
+  }
+  if (!out->impl_->cuda) {
+    try {
+      out->impl_->session = make_session(false);
+    } catch (const std::exception& e) {
+      LOG(ERROR) << "Cannot build the model from " << dvw_path << ": "
+                 << e.what();
+      return nullptr;
+    }
+  }
+  LOG(INFO) << "call_variants: ONNX Runtime " << Ort::GetVersionString()
+            << " on " << (out->impl_->cuda ? "CUDA (FP32, TF32 off)" : "CPU")
+            << ", input " << height << "x" << width << "x" << channels;
+  return out;
+}
+
+bool OnnxInception::Predict(const uint8_t* images, int n, float* probs) {
+  if (n <= 0) return true;
+  const std::vector<int64_t> shape = {n, impl_->h, impl_->w, impl_->c};
+  const size_t count =
+      static_cast<size_t>(n) * impl_->h * impl_->w * impl_->c;
+  try {
+    Ort::Value input = Ort::Value::CreateTensor<uint8_t>(
+        impl_->cpu_memory, const_cast<uint8_t*>(images), count, shape.data(),
+        shape.size());
+    const std::vector<int64_t> out_shape = {n, 3};
+    Ort::Value output = Ort::Value::CreateTensor<float>(
+        impl_->cpu_memory, probs, static_cast<size_t>(n) * 3,
+        out_shape.data(), out_shape.size());
+    const char* in_names[] = {"images"};
+    const char* out_names[] = {"probs"};
+    impl_->session.Run(Ort::RunOptions{nullptr}, in_names, &input, 1,
+                       out_names, &output, 1);
+  } catch (const std::exception& e) {
+    LOG(ERROR) << "Inference failed: " << e.what();
+    return false;
+  }
+  return true;
+}
+
+}  // namespace deepvariant
