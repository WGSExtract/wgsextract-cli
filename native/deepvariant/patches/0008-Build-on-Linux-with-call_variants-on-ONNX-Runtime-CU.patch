+++ b/deepvariant/native/onnx_inference.h
@@ -0,0 +1,47 @@
+// call_variants' Linux backend: DeepVariant's Inception-v3 built from a .dvw
+// weight bundle with ONNX Runtime's model editor API (no .onnx file), run on
+// an NVIDIA GPU through the CUDA execution provider or on the CPU.
+//
+// The graph takes the examples' uint8 NHWC pileups and does upstream's
+// preprocessing ((x - 128) / 128) itself, so only bytes cross to the GPU.
+// Every conv is folded with its BatchNormalization (gamma 1, epsilon 1e-3),
+// as in metal_inference.mm, and the (conv, BN) layer_with_weights pairs are
+// that file's. CUDA runs in FP32 with TF32 off: TF32 rounds the conv inputs
+// to 10-bit mantissas, which moves probabilities far more than
+// TensorFlow's own FP32 does.
+#pragma once
+
+#include <cstdint>
+#include <memory>
+#include <string>
+
+namespace deepvariant {
+
+class OnnxInception {
+ public:
+  enum class Device { kAuto, kCuda, kCpu };
+
+  // `device` kAuto uses CUDA when its provider loads and a GPU is usable,
+  // else the CPU; kCuda fails without one. `cpu_threads` (0 = ONNX Runtime's
+  // default) bounds the CPU provider. Returns nullptr on failure.
+  static std::unique_ptr<OnnxInception> Create(const std::string& dvw_path,
+                                               int height, int width,
+                                               int channels, Device device,
+                                               int cpu_threads, int gpu_id);
+  ~OnnxInception();
+
+  // images: n × H × W × C uint8 (the examples' bytes). probs: n × 3.
+  bool Predict(const uint8_t* images, int n, float* probs);
+
+  bool UsesCuda() const;
+
+  OnnxInception(const OnnxInception&) = delete;
+  OnnxInception& operator=(const OnnxInception&) = delete;
+
+ private:
+  OnnxInception();
+  struct Impl;
+  std::unique_ptr<Impl> impl_;
+};
+
+}  // namespace deepvariant
