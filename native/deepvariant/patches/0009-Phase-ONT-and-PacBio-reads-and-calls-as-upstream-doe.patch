+class PhaseSetStitcher {
+ public:
+  explicit PhaseSetStitcher(const std::string& switches_path) {
+    std::ifstream in(switches_path);
+    std::string line;
+    while (std::getline(in, line)) {
+      if (line.empty()) continue;
+      std::vector<std::string> parts = absl::StrSplit(line, '\t');
+      int status = 0;
+      CHECK(parts.size() == 3 && absl::SimpleAtoi(parts[2], &status))
+          << "Invalid line in switches file: " << line;
+      status_[{parts[0], parts[1]}] = status;
+    }
