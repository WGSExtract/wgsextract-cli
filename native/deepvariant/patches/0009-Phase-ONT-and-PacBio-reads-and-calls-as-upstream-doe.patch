 namespace {
 
+// dv_constants.PHASE_READS_REGION_PADDING_PCT and --phase_max_candidates'
+// default.
+constexpr int64_t kPhaseReadsRegionPaddingPct = 20;
+constexpr int64_t kPhaseMaxCandidates = 5000;
+
+// Upstream's make_examples_core.py constants for inferring an allele's phase
+// from the phases of the reads that support it.
+constexpr int kMinDiffReadsForAllelePhase = 3;
+constexpr int kMaxNumReadsForOppositePhase = 2;
+
+int PhasedGenotypeFromCounts(int phase_1_count, int phase_2_count) {
+  if (phase_1_count > phase_2_count &&
+      phase_1_count - phase_2_count > kMinDiffReadsForAllelePhase &&
+      phase_2_count <= kMaxNumReadsForOppositePhase) {
+    return 1;
+  }
+  if (phase_2_count > phase_1_count &&
+      phase_2_count - phase_1_count > kMinDiffReadsForAllelePhase &&
+      phase_1_count <= kMaxNumReadsForOppositePhase) {
+    return 2;
+  }
+  return 0;
+}
+
+// Port of upstream's RegionProcessor.add_phasing_to_candidate
+// (make_examples_core.py): ALT_PS holds a phase (0, 1 or 2) for REF and each
+// alt allele, from DirectPhasing's phased variants where it phased the
+// candidate and otherwise from the phases of the reads supporting each
+// allele. `read_phases` holds the reads phased 1 or 2.
+void AddPhasingToCandidates(
+    const std::vector<
+        ::learning::genomics::deepvariant::PhasedVariant>& phased_variants,
+    const std::unordered_map<std::string, int8_t>& read_phases,
+    const std::string& phase_contig,
+    std::vector<DeepVariantCall>* candidates) {
+  size_t pv_index = 0;
+  for (auto& candidate : *candidates) {
+    auto* variant = candidate.mutable_variant();
+    const int n_alleles = variant->alternate_bases_size() + 1;
+    if (pv_index < phased_variants.size() &&
+        variant->start() == phased_variants[pv_index].position) {
+      const auto& pv = phased_variants[pv_index];
+      // Upstream names REF "REF" here, as DirectPhasing does.
+      std::vector<std::string> alleles = {"REF"};
+      for (const auto& alt : variant->alternate_bases()) alleles.push_back(alt);
+      const auto alt_1 = std::find(alleles.begin(), alleles.end(),
+                                   pv.phase_1_bases);
+      const auto alt_2 = std::find(alleles.begin(), alleles.end(),
+                                   pv.phase_2_bases);
+      if (alt_1 != alleles.end() && alt_2 != alleles.end()) {
+        std::vector<int> phased_genotype(n_alleles, 0);
+        phased_genotype[alt_1 - alleles.begin()] = 1;
+        phased_genotype[alt_2 - alleles.begin()] = 2;
+        nucleus::SetInfoField("ALT_PS", phased_genotype, variant);
+        nucleus::SetInfoField("PS_CONTIG", phase_contig, variant);
+        nucleus::SetInfoField("FIRST_VARIANT_IN_BLOCK", pv.is_first_in_block,
+                              variant);
+      }
+      ++pv_index;
+      continue;
+    }
+    auto count = [&](const std::string& read_name, int* phases) {
+      auto it = read_phases.find(read_name);
+      if (it != read_phases.end()) ++phases[it->second];
+    };
+    std::vector<int> phased_genotype(n_alleles, 0);
+    for (int allele = 0; allele < n_alleles; ++allele) {
+      int phases[3] = {0, 0, 0};
+      if (allele == 0) {
+        for (const auto& info : candidate.ref_support_ext().read_infos()) {
+          count(info.read_name(), phases);
+        }
+      } else {
+        auto it = candidate.allele_support().find(
+            variant->alternate_bases(allele - 1));
+        if (it != candidate.allele_support().end()) {
+          for (const auto& name : it->second.read_names()) count(name, phases);
+        }
+      }
+      phased_genotype[allele] = PhasedGenotypeFromCounts(phases[1], phases[2]);
+    }
+    nucleus::SetInfoField("ALT_PS", phased_genotype, variant);
+    nucleus::SetInfoField("PS_CONTIG", phase_contig, variant);
+    nucleus::SetInfoField("FIRST_VARIANT_IN_BLOCK", false, variant);
+  }
+}
