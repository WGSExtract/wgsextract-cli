+    const auto status_it = status_.find({parts[0], parts[1]});
+    const StitchingStatus status = static_cast<StitchingStatus>(
+        status_it == status_.end() ? 0 : status_it->second);
+    const auto new_set = [&] {
+      PhaseSetInfo info;
+      info.shard = parts[0];
+      info.region = parts[1];
+      info.status = status;
+      info.is_first_variant_in_phase_set = true;
+      info.phase_set_start = variant.start();
+      return info;
+    };
+    if (previous_.is_null()) return new_set();
+    if (parts[0] == previous_.shard && parts[1] == previous_.region) {
+      PhaseSetInfo info = previous_;
+      if (previous_.was_phased_successfully) {
+        info.is_first_variant_in_phase_set = false;
+      }
+      return info;
+    }
+    const auto first = variant.info().find("FIRST_VARIANT_IN_BLOCK");
+    const bool first_in_block = first != variant.info().end() &&
+                                first->second.values_size() > 0 &&
+                                first->second.values(0).bool_value();
+    if (first_in_block || status == StitchingStatus::kNotEnoughOverlap) {
+      return new_set();
+    }
+    PhaseSetInfo info;
+    info.shard = previous_.shard;
+    info.region = previous_.region;
+    info.status = status;
+    info.phase_set_start = previous_.phase_set_start;
+    return info;
+  }
+
+  static void MaybeSwapPhase(Variant* variant, const PhaseSetInfo& info) {
+    if (!variant->info().count("PS_CONTIG") ||
+        !variant->info().count("ALT_PS") || !variant->calls(0).is_phased()) {
+      return;
+    }
+    VariantCall* call = variant->mutable_calls(0);
+    if (info.status == StitchingStatus::kSwitch &&
+        call->genotype(0) != call->genotype(1)) {
+      const int g0 = call->genotype(0);
+      call->set_genotype(0, call->genotype(1));
+      call->set_genotype(1, g0);
+    }
+    nucleus::SetInfoField("PS", static_cast<int>(info.phase_set_start + 1),
+                          call);
+  }
+
+  std::map<std::pair<std::string, std::string>, int> status_;
+  PhaseSetInfo previous_;
+};
