+// Port of upstream postprocess_variants.py:maybe_phase_genotype. ALT_PS
+// (make_examples --output_phase_info) holds a haplotype (0, 1 or 2) for REF
+// and each of the candidate's alt alleles; a genotype whose two alleles sit
+// on different haplotypes is phased and ordered by haplotype. As upstream,
+// ALT_PS keeps the candidate's allele indexing when alleles were pruned.
+void MaybePhaseGenotype(const Variant& variant, VariantCall* call) {
+  const auto ps_contig = variant.info().find("PS_CONTIG");
+  const auto alt_ps = variant.info().find("ALT_PS");
+  if (ps_contig == variant.info().end() ||
+      ps_contig->second.values_size() == 0 ||
+      ps_contig->second.values(0).string_value().empty() ||
+      alt_ps == variant.info().end() || alt_ps->second.values_size() == 0) {
+    return;  // the trio path's own is_phased and PS stay as they are
+  }
+  call->set_is_phased(false);
+  const auto& phase_info = alt_ps->second.values();
+  const int g0 = call->genotype(0);
+  const int g1 = call->genotype(1);
+  if (std::max(g0, g1) >= phase_info.size() || std::min(g0, g1) < 0) {
+    LOG(WARNING) << "Genotype " << g0 << "/" << g1
+                 << " is out of range for phase info at "
+                 << variant.reference_name() << ":" << variant.start() + 1
+                 << ". Phasing was not applied.";
+    return;
+  }
+  const int h0 = phase_info.Get(g0).int_value();
+  const int h1 = phase_info.Get(g1).int_value();
+  if (h0 == 0 || h1 == 0 || h0 == h1) return;
+  const int genotype[2] = {g0, g1};
+  call->clear_genotype();
+  call->add_genotype(genotype[h0 - 1]);
+  call->add_genotype(genotype[h1 - 1]);
+  call->set_is_phased(true);
+}
